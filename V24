    process?.versions?.node &&
    Array.isArray(process.argv) &&
    process.argv.includes('--self-test');

  if (nodeSelfTest) {
    const result = runSelfTests();
    if (!result.passed) {
      throw new Error('Self-tests failed: ' + result.failures.join(', '));
    }
    console.log('Flo-lite RCA self-tests passed: ' + result.count);
    return;
  }

  if (typeof window === 'undefined' || typeof document === 'undefined') {
    throw new Error('Run this file as a Chrome DevTools Snippet from Flo-lite.');
  }
  if (location.origin !== DEFAULTS.allowedOrigin) {
    throw new Error(
      'Run this from the confirmed Flo-lite origin ' + DEFAULTS.allowedOrigin +
        '. Current origin: ' + location.origin
    );
  }

  function defaultStoredState() {
    return {
      version: 1,
      sourceFacilityId: DEFAULTS.sourceFacilityId,
      userId: DEFAULTS.userId,
      caseMaster: { raw: '', updatedAt: '' },
      bulkMaster: { raw: '', updatedAt: '' }
    };
  }

  function loadStoredState() {
    const fallback = defaultStoredState();
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (!parsed || typeof parsed !== 'object') return fallback;
      return {
        version: 1,
        sourceFacilityId: exactText(parsed.sourceFacilityId) || fallback.sourceFacilityId,
        userId: exactText(parsed.userId) || fallback.userId,
        caseMaster: {
          raw: typeof parsed.caseMaster?.raw === 'string' ? parsed.caseMaster.raw : '',
          updatedAt: exactText(parsed.caseMaster?.updatedAt)
        },
        bulkMaster: {
          raw: typeof parsed.bulkMaster?.raw === 'string' ? parsed.bulkMaster.raw : '',
          updatedAt: exactText(parsed.bulkMaster?.updatedAt)
        }
      };
    } catch (error) {
      console.warn('RCA saved master/settings could not be read:', error);
      return fallback;
    }
  }

  let storedState = loadStoredState();
  let lastRun = null;

  function persistStoredState(nextState) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(nextState));
    storedState = nextState;
  }

  function ensureCache() {
    const existing = window[CACHE_KEY];
    const cache = existing && typeof existing === 'object' ? existing : {};
    ['iwit', 'outbound', 'mapping', 'tl'].forEach(name => {
      if (!(cache[name] instanceof Map)) cache[name] = new Map();
    });
    window[CACHE_KEY] = cache;
    return cache;
  }

  const responseCache = ensureCache();

  function clearResponseCaches() {
    Object.values(responseCache).forEach(cache => {
      if (cache instanceof Map) cache.clear();
    });
  }

  document.getElementById('flo-lite-rca-facility-context-frame')?.remove();

  const facilityContextBroker = {
    frame: null,
    currentKey: '',
    currentContext: null,
