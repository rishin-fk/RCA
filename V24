  async function mapWithLimit(items, limit, worker) {
    const results = new Array(items.length);
    let nextIndex = 0;
    async function runner() {
      while (true) {
        const index = nextIndex;
        nextIndex += 1;
        if (index >= items.length) return;
        results[index] = await worker(items[index], index);
      }
    }
    const runnerCount = Math.min(Math.max(1, limit), items.length);
    await Promise.all(Array.from({ length: runnerCount }, () => runner()));
    return results;
  }

  function apiFailure(prefix, result) {
    if (result?.skipped) {
      return prefix + ' NOT_REQUESTED: ' + (result.error || 'Dependency unavailable.');
    }
    if (result?.contextMismatch) {
      return (
        prefix + ' FACILITY_CONTEXT_MISMATCH: intended ' +
        result.contextMismatch.intendedFacility + ', server used ' +
        result.contextMismatch.observedFacility + ' after isolated-context retry.'
      );
    }
    if (result?.contextFailure) {
      return prefix + ' CONTEXT_ESTABLISHMENT_FAILED: ' + result.error;
    }
    return (
      prefix +
      ' HTTP ' +
      (result?.status ?? 0) +
      ': ' +
      (result?.error || 'Unknown error')
    );
  }

  function finalFailureRecord(result, fallback = {}) {
    if (!result || result.ok || result.skipped) return null;
    const info = result.requestInfo || {};
    return {
      requestType: exactText(info.requestType || fallback.requestType || 'Unknown'),
      method: exactText(info.method || fallback.method || 'GET'),
      status: result.status ?? 0,
      boxId: exactText(info.boxId || fallback.boxId),
      documentId: exactText(info.documentId || fallback.documentId),
      tlId: exactText(info.tlId || fallback.tlId),
      path: exactText(info.path),
      contextType: exactText(info.contextType || fallback.contextType),
      contextBoxId: exactText(info.contextBoxId),
      referrerPath: exactText(info.referrerPath),
      error: exactText(result.error)
    };
  }

  function dedupeFailureLedger(records) {
    const byKey = new Map();
    records.filter(Boolean).forEach(record => {
      const key = JSON.stringify([
        record.requestType,
        record.method,
        record.status,
        record.boxId,
        record.documentId,
        record.tlId,
        record.path,
        record.contextType,
        record.contextBoxId
      ]);
      if (!byKey.has(key)) byKey.set(key, record);
    });
    return Array.from(byKey.values());
  }

  function failureBreakdown(ledger) {
    const counts = new Map();
    ledger.forEach(record => {
      const key = record.requestType + ' HTTP ' + record.status;
      counts.set(key, (counts.get(key) || 0) + 1);
    });
    return Array.from(counts.entries())
      .map(([category, count]) => ({ category, count }))
      .sort((a, b) => b.count - a.count || a.category.localeCompare(b.category));
  }

