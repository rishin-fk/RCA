/*
 * Flo-lite RCA Automation — portable reconciliation build v2.3.5
 *
 * Run as a Chrome DevTools Snippet from a logged-in Flo-lite tab.
 * Fetches existing RCA data via GET and sorter details via one scoped POST endpoint.
 * Persistent browser storage contains only Case/Bulk masters and settings.
 * Report rows and Flo-lite API responses remain in the current tab memory.
 */

(async () => {
  'use strict';

  const VERSION = '2.3.5-employee-attribution';
  const STORAGE_KEY = 'floLiteRcaAutomation.v2.portable.masterAndSettings';
  const OVERLAY_ID = 'flo-lite-rca-final-overlay';
  const CACHE_KEY = '__floLiteRcaV2PortableCache';
  const QUANTITY_SCOPE = 'Box+FSN (repeated on each pasted row)';
  const TL_SEQUENCE_COVERAGE_THRESHOLD = 0.9;
  const TL_SEQUENCE_BOX_MISSING_THRESHOLD = 0.3;
  const TL_SEQUENCE_BOX_UNIT_THRESHOLD = 40;

  const DEFAULTS = Object.freeze({
    allowedOrigin: 'http://10.24.1.71',
    sourceFacilityId: '',
    userId: '',
    concurrency: 3,
    retries: 2,
    mappingRetries: 1,
    timeoutMs: 20000
  });

  const PHYSICAL_LIMITS = Object.freeze({
    toteVolumeCm3: 39000,
    toteWeightKg: 26,
    mappingVolumeUnit: 'cm³',
    mappingWeightUnit: 'kg'
  });

  const LABELS = Object.freeze({
    coldMismatch: 'Cold Mismatch',
    coldShort: 'Cold Short',
    pbdMismatch: 'PBD Mismatch',
    pbdShort: 'PBD Short',
    psMismatch: 'P&S Mismatch',
    psShort: 'P&S Short',
    pbdMisshipment: 'PBD Short - Misshipment',
    psMisshipment: 'P&S Short - Misshipment',
    coldMisshipment: 'Cold Short - Misshipment',
    sameFsnAddexcess: 'Same FSN Addexcess',
    caseMismatch: 'CASE FSN MISMATCH',
    caseMisshipment: 'CASE FSN Misshipment',
    bulkMismatch: 'BULK Mismatch',
    bulkMisshipment: 'Bulk Short - Misshipment',
    packingSlipMismatch: 'Packing Slip Mismatch',
    orphanTote: 'Orphan Tote',
    tlSequenceOrphan: 'Orphan Tote - TL Sequence wise',
    caseMultipleShort: 'Orphan Tote - Case multiple',
    caseNonMultipleShort: 'Case FSN non multiple short',
    bulkShort: 'Bulk FSN short'
  });

  const ENDPOINTS = Object.freeze({
    iwit: (boxId, documentId) =>
      '/hyperlocal-flo-lite-api/inbound-hyperlocal-proxy/api/v2/get_items_in_box/' +
      encodeURIComponent(boxId) +
      '?for_visibility=true&consignment_id=' +
      encodeURIComponent(documentId),
    outbound: boxId =>
      '/flo-lite-routes-api/psd-controller-routes/api/v1/container/' +
      encodeURIComponent(boxId) +
      '/details?use_case_context=VIEW_BOX_PAGE',
    mapping: (sourceFacilityId, boxId) =>
      '/flo-lite-routes-api/outbound-picking-proxy/sortationService/' +
      'inputContainerOutputContainerMapping/facilityId/' +
      encodeURIComponent(sourceFacilityId) +
      '/label/' +
      encodeURIComponent(boxId),
    tl: tlId =>
      '/flo-lite-routes-api/outbound-picking-proxy/api/v3.0/picklists/' +
      encodeURIComponent(tlId)
  });

  function facilityContextPath(facilityId, contextType, boxId = '') {
    const encodedFacility = encodeURIComponent(exactText(facilityId));
    if (contextType === 'iwit') {
      return '/flo-lite/' + encodedFacility + '/desktop/IWIT/dashboard';
    }
    if (contextType === 'ps-mapping') {
      return '/flo-lite/' + encodedFacility + '/v2/desktop/ncob/input-output-mapping';
    }
    return '/flo-lite/' + encodedFacility + '/desktop/v2/track-variance';
  }

  function psNcobBoxPath(facilityId, boxId) {
    const exactBoxId = exactText(boxId);
    if (!exactBoxId) throw new Error('P&S NCOB context requires an exact Box ID.');
    return facilityContextPath(facilityId, 'ps-mapping') + '/' + encodeURIComponent(exactBoxId);
  }

  function exactText(value) {
    return value === null || value === undefined ? '' : String(value).trim();
  }

  function fsnKey(value) {
    return exactText(value).toUpperCase();
  }

  function verticalKey(value) {
    return exactText(value).toLowerCase();
  }

  function normalizeHeader(value) {
    return exactText(value)
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '');
  }

  function finiteNumber(value, fallback = null) {
    if (value === '' || value === null || value === undefined) return fallback;
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
  }

  function positiveNumber(value, fallback = 0) {
    const parsed = finiteNumber(value, fallback);
    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
  }

  function unique(values) {
    return Array.from(new Set(values.filter(value => value !== '' && value != null)));
  }

  function nonEmptyTsvLines(raw) {
    return String(raw || '')
      .replace(/\r/g, '')
      .split('\n')
      .filter(line => line.trim() !== '');
  }

  function tsvSafe(value) {
    if (Array.isArray(value)) value = value.join(' | ');
    if (value && typeof value === 'object') value = JSON.stringify(value);
    return String(value ?? '').replace(/[\t\r\n]+/g, ' ');
  }

  function normaliseImageUrl(value) {
    let raw = value;
    if (raw && typeof raw === 'object') {
      raw = deepField(raw, ['url', 'src', 'imageUrl', 'image_url', 'originalUrl'], 3);
    }
    const text = exactText(raw);
    if (!text) return '';
    try {
      const parsed = new URL(text);
      return ['http:', 'https:'].includes(parsed.protocol) ? parsed.href : '';
    } catch {
      return '';
    }
  }

  function itemImageUrl(item) {
    return normaliseImageUrl(
      itemField(
        item,
        [
          'image',
          'imageUrl',
          'image_url',
          'productImage',
          'product_image',
          'imageLink',
          'image_link'
        ],
        true
      )
    );
  }

  function sheetsImageFormula(imageUrl) {
    const safeUrl = normaliseImageUrl(imageUrl);
    return safeUrl ? '=IMAGE("' + safeUrl.replace(/"/g, '""') + '")' : '';
  }

  function isoNow() {
    return new Date().toISOString();
  }

  function timestampForFilename() {
    return new Date().toISOString().replace(/[:.]/g, '-');
  }

  function directField(object, aliases) {
    if (!object || typeof object !== 'object' || Array.isArray(object)) return undefined;
    const wanted = new Set(aliases.map(alias => normalizeHeader(alias)));
    for (const [key, value] of Object.entries(object)) {
      if (wanted.has(normalizeHeader(key))) return value;
    }
    return undefined;
  }

  function deepField(root, aliases, maxDepth = 4) {
    const direct = directField(root, aliases);
    if (direct !== undefined) return direct;
    const queue = [{ value: root, depth: 0 }];
    const visited = new Set();

    while (queue.length) {
      const { value, depth } = queue.shift();
      if (!value || typeof value !== 'object' || visited.has(value)) continue;
      visited.add(value);
      if (depth >= maxDepth) continue;

      const children = Array.isArray(value) ? value : Object.values(value);
      for (const child of children) {
        if (!child || typeof child !== 'object') continue;
        const found = directField(child, aliases);
        if (found !== undefined) return found;
        queue.push({ value: child, depth: depth + 1 });
      }
    }
    return undefined;
  }

  function findArrays(root, aliases, maxDepth = 6) {
    const wanted = new Set(aliases.map(alias => normalizeHeader(alias)));
    const found = [];
    const queue = [{ value: root, depth: 0 }];
    const visited = new Set();

    while (queue.length) {
      const { value, depth } = queue.shift();
      if (!value || typeof value !== 'object' || visited.has(value)) continue;
      visited.add(value);
      if (depth > maxDepth) continue;

      if (!Array.isArray(value)) {
        for (const [key, child] of Object.entries(value)) {
          if (wanted.has(normalizeHeader(key)) && Array.isArray(child)) found.push(child);
          if (child && typeof child === 'object') {
            queue.push({ value: child, depth: depth + 1 });
          }
        }
      } else {
        value.forEach(child => {
          if (child && typeof child === 'object') {
            queue.push({ value: child, depth: depth + 1 });
          }
        });
      }
    }
    return found;
  }

  function firstArray(root, aliases, maxDepth = 6) {
    const arrays = findArrays(root, aliases, maxDepth);
    return arrays.length ? arrays[0] : [];
  }

  function scalarIdentifier(value) {
    if (typeof value === 'string' || typeof value === 'number') return exactText(value);
    if (!value || typeof value !== 'object') return '';
    return exactText(
      directField(value, ['label', 'id', 'value', 'name', 'externalId', 'containerId'])
    );
  }

  function locationLabel(value) {
    if (typeof value === 'string' || typeof value === 'number') return exactText(value);
    if (!value || typeof value !== 'object') return '';
    return exactText(
      directField(value, ['label', 'locationLabel', 'name', 'id', 'locationId'])
    );
  }

  function booleanValue(value) {
    if (typeof value === 'boolean') return value;
    const compact = exactText(value).toLowerCase();
    if (compact === 'true') return true;
    if (compact === 'false') return false;
    return null;
  }

  function normalizeFlow(value) {
    const compact = exactText(value).toUpperCase().replace(/\s+/g, '');
    if (compact.includes('PBD')) return 'PBD';
    if (compact.includes('P&S') || compact.includes('PNS')) return 'P&S';
    return '';
  }

  function looksLikeTlId(value) {
    return /^PL[A-Z0-9_-]+$/i.test(exactText(value));
  }

  function collectTlIds(root, maxDepth = 7) {
    const ids = [];
    const queue = [{ value: root, depth: 0 }];
    const visited = new Set();
    const preferredKeys = new Set(
      [
        'externalReferenceId',
        'pickingReferenceId',
        'picklistId',
        'pickListId',
        'tlId',
        'externalPicklistId'
      ].map(normalizeHeader)
    );

    while (queue.length) {
      const { value, depth } = queue.shift();
      if (!value || typeof value !== 'object' || visited.has(value) || depth > maxDepth) {
        continue;
      }
      visited.add(value);

      if (Array.isArray(value)) {
        value.forEach(child => {
          if (child && typeof child === 'object') queue.push({ value: child, depth: depth + 1 });
          else if (looksLikeTlId(child)) ids.push(exactText(child));
        });
        continue;
      }

      Object.entries(value).forEach(([key, child]) => {
        if (preferredKeys.has(normalizeHeader(key)) && looksLikeTlId(child)) {
          ids.push(exactText(child));
        }
        if (child && typeof child === 'object') queue.push({ value: child, depth: depth + 1 });
      });
    }
    return unique(ids);
  }

  function parseCaseMaster(raw, options = {}) {
    const lines = nonEmptyTsvLines(raw);
    const caseSizeByFsn = new Map();
    const errors = [];
    const warnings = [];
    let fsnIndex = 0;
    let caseSizeIndex = 1;
    let startIndex = 0;

    if (!lines.length) {
      if (!options.allowEmpty) errors.push('Case master is empty. Use Clear Case Master to remove it.');
      return { caseSizeByFsn, errors, warnings, raw: '' };
    }

    const firstCells = lines[0].split('\t');
    const headers = firstCells.map(normalizeHeader);
    const detectedFsn = headers.findIndex(header => header === 'fsn');
    const detectedCaseSize = headers.findIndex(header =>
      ['case_size', 'casesize', 'case_qty', 'case_quantity'].includes(header)
    );

    if (detectedFsn >= 0 || detectedCaseSize >= 0) {
      if (detectedFsn < 0 || detectedCaseSize < 0) {
        errors.push('Case master header must contain both FSN and CASE SIZE.');
        return { caseSizeByFsn, errors, warnings, raw: String(raw || '') };
      }
      fsnIndex = detectedFsn;
      caseSizeIndex = detectedCaseSize;
      startIndex = 1;
    }

    lines.slice(startIndex).forEach((line, offset) => {
      const cells = line.split('\t').map(exactText);
      const fsn = fsnKey(cells[fsnIndex]);
      const caseSize = finiteNumber(cells[caseSizeIndex], null);
      const lineNumber = startIndex + offset + 1;

      if (!fsn && !cells[caseSizeIndex]) return;
      if (!fsn) {
        errors.push('Case master line ' + lineNumber + ': FSN is blank.');
        return;
      }
      if (!Number.isInteger(caseSize) || caseSize <= 0) {
        errors.push('Case master line ' + lineNumber + ': CASE SIZE must be a positive integer.');
        return;
      }
      if (caseSizeByFsn.has(fsn)) {
        if (caseSizeByFsn.get(fsn) !== caseSize) {
          errors.push('Case master line ' + lineNumber + ': duplicate FSN has conflicting CASE SIZE.');
        } else {
          warnings.push('Duplicate Case FSN deduplicated: ' + fsn + '.');
        }
        return;
      }
      caseSizeByFsn.set(fsn, caseSize);
    });

    if (!caseSizeByFsn.size && !errors.length && !options.allowEmpty) {
      errors.push('Case master contains no valid data rows.');
    }
    return { caseSizeByFsn, errors, warnings, raw: String(raw || '').replace(/\r/g, '') };
  }

  function parseBulkMaster(raw, options = {}) {
    const lines = nonEmptyTsvLines(raw);
    const bulkFsns = new Set();
    const errors = [];
    const warnings = [];
    let fsnIndex = 0;
    let startIndex = 0;

    if (!lines.length) {
      if (!options.allowEmpty) errors.push('Bulk master is empty. Use Clear Bulk Master to remove it.');
      return { bulkFsns, errors, warnings, raw: '' };
    }

    const firstCells = lines[0].split('\t');
    const headers = firstCells.map(normalizeHeader);
    const detectedFsn = headers.findIndex(header => header === 'fsn');
    if (detectedFsn >= 0) {
      fsnIndex = detectedFsn;
      startIndex = 1;
    } else if (firstCells.length > 1) {
      fsnIndex = 1;
      warnings.push('Bulk master header not detected; using known full-table column B as FSN.');
    }

    lines.slice(startIndex).forEach((line, offset) => {
      const cells = line.split('\t').map(exactText);
      const fsn = fsnKey(cells[fsnIndex]);
      const lineNumber = startIndex + offset + 1;
      if (!fsn) {
        errors.push('Bulk master line ' + lineNumber + ': FSN is blank.');
        return;
      }
      if (bulkFsns.has(fsn)) warnings.push('Duplicate Bulk FSN deduplicated: ' + fsn + '.');
      bulkFsns.add(fsn);
    });

    if (!bulkFsns.size && !errors.length && !options.allowEmpty) {
      errors.push('Bulk master contains no valid data rows.');
    }
    return { bulkFsns, errors, warnings, raw: String(raw || '').replace(/\r/g, '') };
  }

  function mastersReady(caseMaster, bulkMaster) {
    return Boolean(caseMaster?.caseSizeByFsn?.size && bulkMaster?.bulkFsns?.size);
  }

  function parseRows(raw) {
    const lines = nonEmptyTsvLines(raw);
    const rows = [];
    const errors = [];
    let headerIndexes = null;

    lines.forEach((line, sourceLineIndex) => {
      const cells = line.split('\t').map(exactText);
      const headers = cells.map(normalizeHeader);
      const headerIndex = aliases => headers.findIndex(header => aliases.includes(header));
      const possibleHeader = {
        facility: headerIndex(['destination_party_id', 'destination_facility', 'facility']),
        documentId: headerIndex(['document_id', 'consignment_id', 'document']),
        boxId: headerIndex(['external_id', 'box_id', 'boxid']),
        fsn: headerIndex(['fsn']),
        quantity: headerIndex(['qty', 'quantity']),
        vertical: headerIndex(['cms_vertical', 'vertical']),
        location: headerIndex(['location', 'physical_location', 'storage_location'])
      };
      const looksLikeHeader =
        possibleHeader.facility >= 0 &&
        possibleHeader.documentId >= 0 &&
        possibleHeader.boxId >= 0 &&
        possibleHeader.fsn >= 0;

      if (looksLikeHeader) {
        headerIndexes = possibleHeader;
        return;
      }

      let indexes;
      let quantityMayDefault = false;
      if (headerIndexes) {
        indexes = headerIndexes;
        quantityMayDefault = indexes.quantity < 0;
      } else if (cells.length >= 25) {
        indexes = { facility: 0, documentId: 1, boxId: 2, fsn: 4, quantity: 7, vertical: 10, location: 24 };
      } else if (cells.length >= 8) {
        indexes = { facility: 0, documentId: 1, boxId: 2, fsn: 4, quantity: 7, vertical: -1, location: -1 };
      } else if (cells.length === 7) {
        indexes = { facility: 0, documentId: 1, boxId: 2, fsn: 3, quantity: 4, vertical: 5, location: 6 };
      } else if (cells.length === 6) {
        indexes = { facility: 0, documentId: 1, boxId: 2, fsn: 3, quantity: 5, vertical: -1, location: -1 };
      } else if (cells.length >= 5) {
        indexes = { facility: 0, documentId: 1, boxId: 2, fsn: 4, quantity: -1, vertical: -1, location: -1 };
        quantityMayDefault = true;
      } else {
        errors.push('Input line ' + (sourceLineIndex + 1) + ': expected B:Z, B:I, or supported visible columns.');
        return;
      }

      const quantityCell = indexes.quantity >= 0 ? cells[indexes.quantity] : '';
      const quantity = quantityMayDefault && !quantityCell ? 1 : finiteNumber(quantityCell, null);
      const row = {
        inputRow: rows.length + 1,
        sourceLine: sourceLineIndex + 1,
        facility: indexes.facility >= 0 ? cells[indexes.facility] || '' : '',
        documentId: indexes.documentId >= 0 ? cells[indexes.documentId] || '' : '',
        boxId: indexes.boxId >= 0 ? cells[indexes.boxId] || '' : '',
        fsn: indexes.fsn >= 0 ? cells[indexes.fsn] || '' : '',
        quantity,
        sheetVertical: indexes.vertical >= 0 ? cells[indexes.vertical] || '' : '',
        location: indexes.location >= 0 ? cells[indexes.location] || '' : ''
      };

      const missing = [];
      if (!row.facility) missing.push('destination facility');
      if (!row.documentId) missing.push('document ID');
      if (!row.boxId) missing.push('Box ID');
      if (!row.fsn) missing.push('FSN');
      if (!Number.isFinite(row.quantity) || row.quantity <= 0) missing.push('positive quantity');

      if (missing.length) {
        errors.push('Input line ' + (sourceLineIndex + 1) + ': missing/invalid ' + missing.join(', ') + '.');
      } else {
        rows.push(row);
      }
    });

    if (!rows.length && !errors.length) errors.push('Paste at least one Google Sheets data row.');
    return { rows, errors };
  }

  function iwitKey(row) {
    return JSON.stringify([row.facility, row.documentId, row.boxId]);
  }

  function boxFsnKey(row) {
    return JSON.stringify([row.facility, row.documentId, row.boxId, fsnKey(row.fsn)]);
  }

  function deepBoxKey(sourceFacilityId, boxId) {
    return JSON.stringify([sourceFacilityId, boxId]);
  }

  function tlCacheKey(sourceFacilityId, tlId) {
    return JSON.stringify([sourceFacilityId, tlId]);
  }

  function itemField(item, aliases, deep = false) {
    return deep ? deepField(item, aliases, 3) : directField(item, aliases);
  }

  function normaliseIwitItem(item, isExcess = false) {
    const expectedRaw = itemField(item, ['expected_quantity', 'expectedQuantity']);
    const receivedRaw = itemField(item, ['received_quantity', 'receivedQuantity']);
    const quantityRaw = itemField(item, ['quantity', 'qty']);
    const expected = finiteNumber(
      expectedRaw,
      isExcess ? 0 : finiteNumber(quantityRaw, 0)
    );
    const received = finiteNumber(receivedRaw, isExcess ? finiteNumber(quantityRaw, 0) : 0);
    const quantity = finiteNumber(quantityRaw, 0);
    // Reporting-only quantities must mirror the named IWIT fields exactly.
    // Do not fall back to `quantity` here; that field has different semantics.
    const outputExpectedQuantity = isExcess ? 0 : finiteNumber(expectedRaw, 0);
    const outputReceivedQuantity = isExcess ? 0 : received;
    const taxonomy = itemField(item, ['taxonomy_attributes', 'taxonomyAttributes']);
    const temperature = exactText(
      directField(taxonomy, ['temperature']) ?? itemField(item, ['temperature'], true)
    );
    const imageUrl = itemImageUrl(item);
    return {
      fsn: exactText(itemField(item, ['fsn', 'FSN'])),
      wid: exactText(itemField(item, ['wid', 'WID'])),
      expected,
      received,
      quantity,
      outputExpectedQuantity,
      outputReceivedQuantity,
      vertical: exactText(itemField(item, ['cms_vertical', 'cmsVertical', 'vertical'])),
      temperature,
      sourceLocation: locationLabel(itemField(item, ['sourceLocation', 'source_location'], true)),
      imageUrl,
      imageSource: imageUrl ? 'IWIT/MWIT' : '',
      raw: item
    };
  }

  function excessUnits(item) {
    return Math.max(
      item.received - item.expected,
      item.expected === 0 ? item.quantity : 0,
      0
    );
  }

  function buildAllocationContext(
    body,
    caseSizeByFsn = new Map(),
    bulkFsns = new Set(),
    fallbackVerticalByFsn = new Map(),
    analysedShortByFsn = new Map()
  ) {
    const rawItems = firstArray(body, ['items_in_box', 'itemsInBox']);
    const rawExcessItems = firstArray(body, ['excess_items', 'excessItems']);
    const items = rawItems.map(item => normaliseIwitItem(item, false));
    const excessItems = rawExcessItems.map(item => normaliseIwitItem(item, true));
    const metaByFsn = new Map();
    const shortRemainingByFsn = new Map();
    const boxShortUnitsByFsn = new Map();
    const excessEntries = [];
    const distinctFsns = new Set();
    const verticalConflictFsns = new Set();

    items.forEach(item => {
      const key = fsnKey(item.fsn);
      if (!key) return;
      distinctFsns.add(key);
      const existing = metaByFsn.get(key) || {
        fsn: item.fsn,
        wid: item.wid,
        expected: 0,
        received: 0,
        outputExpectedQuantity: 0,
        outputReceivedQuantity: 0,
        vertical: '',
        temperature: '',
        sourceLocation: '',
        imageUrl: '',
        imageSource: ''
      };
      existing.expected += item.expected;
      existing.received += item.received;
      existing.outputExpectedQuantity += item.outputExpectedQuantity;
      existing.outputReceivedQuantity += item.outputReceivedQuantity;
      if (
        existing.vertical &&
        item.vertical &&
        verticalKey(existing.vertical) !== verticalKey(item.vertical)
      ) verticalConflictFsns.add(key);
      existing.vertical ||= item.vertical;
      existing.temperature ||= item.temperature;
      existing.sourceLocation ||= item.sourceLocation;
      existing.imageUrl ||= item.imageUrl;
      existing.imageSource ||= item.imageSource;
      metaByFsn.set(key, existing);
    });
    metaByFsn.forEach((meta, key) => {
      meta.vertical ||= exactText(fallbackVerticalByFsn.get(key));
      const shortUnits = Math.max(meta.expected - meta.received, 0);
      shortRemainingByFsn.set(key, shortUnits);
      if (shortUnits > 0) boxShortUnitsByFsn.set(key, shortUnits);
    });
    const boxExpectedUnitCount = Array.from(metaByFsn.values()).reduce(
      (sum, meta) => sum + Math.max(finiteNumber(meta.expected, 0), 0),
      0
    );
    const boxShortUnitCount = Array.from(boxShortUnitsByFsn.values()).reduce(
      (sum, quantity) => sum + quantity,
      0
    );
    const boxMissingRate = boxExpectedUnitCount > 0
      ? boxShortUnitCount / boxExpectedUnitCount
      : null;

    excessItems.forEach((item, responseIndex) => {
      const fsn = fsnKey(item.fsn);
      if (fsn) distinctFsns.add(fsn);
      const units = excessUnits(item);
      if (!units || !fsn) return;
      const metadataVertical = exactText(metaByFsn.get(fsn)?.vertical);
      if (
        metadataVertical &&
        item.vertical &&
        verticalKey(metadataVertical) !== verticalKey(item.vertical)
      ) verticalConflictFsns.add(fsn);
      excessEntries.push({
        responseIndex,
        fsn,
        displayFsn: item.fsn,
        wid: item.wid,
        vertical:
          item.vertical ||
          metadataVertical ||
          exactText(fallbackVerticalByFsn.get(fsn)),
        sourceLocation: item.sourceLocation,
        imageUrl: item.imageUrl,
        imageSource: item.imageSource,
        original: units,
        remaining: units
      });
    });

    const expectedFsns = new Set();
    const receivedOrExcessFsns = new Set();
    let everyExpectedCompletelyShort = true;
    metaByFsn.forEach((meta, key) => {
      if (meta.expected > 0) {
        expectedFsns.add(key);
        if (meta.received > 0 || meta.expected - meta.received < meta.expected) {
          everyExpectedCompletelyShort = false;
        }
      }
    });
    excessItems.forEach(item => {
      if (excessUnits(item) > 0 && fsnKey(item.fsn)) receivedOrExcessFsns.add(fsnKey(item.fsn));
    });
    const totalExcessUnitCount = excessItems.reduce(
      (sum, item) => sum + excessUnits(item),
      0
    );
    const overlap = Array.from(expectedFsns).some(fsn => receivedOrExcessFsns.has(fsn));
    const packslipSuspected =
      expectedFsns.size > 0 &&
      receivedOrExcessFsns.size > 0 &&
      everyExpectedCompletelyShort &&
      !overlap;
    const packslipConfirmed = packslipSuspected;

    const context = {
      rawItemCount: rawItems.length,
      rawExcessCount: rawExcessItems.length,
      items,
      excessItems,
      metaByFsn,
      shortRemainingByFsn,
      boxShortUnitsByFsn,
      boxExpectedUnitCount,
      boxShortUnitCount,
      boxMissingRate,
      analysedShortByFsn,
      excessEntries,
      verticalConflictFsns,
      distinctFsnCount: distinctFsns.size,
      expectedFsns: Array.from(expectedFsns),
      receivedOrExcessFsns: Array.from(receivedOrExcessFsns),
      packslipSuspected,
      packslipConfirmed,
      packslipShortUnitCount: boxShortUnitCount,
      packslipExcessUnitCount: totalExcessUnitCount,
      schemaWarning: rawItems.length ? '' : 'IWIT/MWIT response did not expose items_in_box.'
    };
    context.reconciliationByFsn = buildBoxReconciliationPlan(
      context,
      caseSizeByFsn,
      bulkFsns
    );
    return context;
  }

  function wholeMultiple(quantity, size) {
    return Number.isFinite(quantity) && Number.isFinite(size) && quantity > 0 && size > 0 && quantity % size === 0;
  }

  function excessEntryOrder(left, right) {
    return (
      left.fsn.localeCompare(right.fsn) ||
      verticalKey(left.vertical).localeCompare(verticalKey(right.vertical)) ||
      left.responseIndex - right.responseIndex
    );
  }

  function verticalRelation(targetVertical, candidateVertical) {
    const target = verticalKey(targetVertical);
    const candidate = verticalKey(candidateVertical);
    if (!target || !candidate) return 'unknown';
    return target === candidate ? 'same' : 'different';
  }

  function candidateEvidence(entry, quantity, targetQuantity = quantity, cartons = 0) {
    return {
      fsn: entry.displayFsn || entry.fsn,
      wid: entry.wid,
      quantity,
      targetQuantity,
      cartons,
      sourceLocation: entry.sourceLocation,
      vertical: entry.vertical,
      imageUrl: entry.imageUrl || '',
      imageSource: entry.imageSource || '',
      quarantinedReason: entry.quarantinedReason || ''
    };
  }

  function consumeEntryUnits(entries, units) {
    let remaining = units;
    entries.forEach(entry => {
      if (remaining <= 0 || entry.remaining <= 0) return;
      const used = Math.min(remaining, entry.remaining);
      entry.remaining -= used;
      remaining -= used;
    });
    return units - remaining;
  }

  function planOutcomeSignature(plan) {
    if (plan.sameFsnExact) return 'same-fsn-addexcess';
    if (plan.quantityConflict || (plan.isCaseFsn && plan.isBulkFsn)) return 'review';
    if (plan.isCaseFsn && !plan.caseShortIsMultiple) return 'case-non-multiple';
    if (plan.mismatchQuantity > 0) {
      return plan.isCaseFsn ? 'case-mismatch' : plan.isBulkFsn ? 'bulk-mismatch' : 'mismatch';
    }
    if (plan.misshipmentQuantity > 0) {
      return plan.isCaseFsn
        ? 'case-misshipment'
        : plan.isBulkFsn
          ? 'bulk-misshipment'
          : 'misshipment';
    }
    if (plan.isCaseFsn) return 'case-multiple';
    if (plan.isBulkFsn) return 'bulk-short';
    return 'short';
  }

  function buildBoxReconciliationPlan(context, caseSizeByFsn, bulkFsns, options = {}) {
    const targetDirection = options.reverseTargets ? -1 : 1;
    const pool = context.excessEntries
      .map(entry => ({ ...entry }))
      .sort(excessEntryOrder);
    const plans = new Map();
    context.metaByFsn.forEach((meta, fsn) => {
      const apiShort = Math.max(meta.expected - meta.received, 0);
      const pastedShort = positiveNumber(context.analysedShortByFsn.get(fsn), 0);
      const originalShort = pastedShort ? Math.min(apiShort, pastedShort) : apiShort;
      if (!originalShort) return;
      plans.set(fsn, {
        fsn,
        vertical: meta.vertical,
        apiShort,
        originalShort,
        remainingShort: originalShort,
        sameFsnExcess: 0,
        sameFsnUsed: 0,
        sameFsnExact: false,
        quantityConflict: '',
        mismatchQuantity: 0,
        misshipmentQuantity: 0,
        unexplainedQuantity: 0,
        mismatchCandidates: [],
        misshipmentCandidates: [],
        isCaseFsn: caseSizeByFsn.has(fsn),
        isBulkFsn: bulkFsns.has(fsn),
        caseSize: caseSizeByFsn.get(fsn) || 0,
        caseShortIsMultiple: false,
        caseCartonsRemaining: 0,
        parallelSameFsnEvidence: false,
        allocationWarning: ''
      });
    });

    const orderedPlans = Array.from(plans.values()).sort(
      (left, right) => targetDirection * left.fsn.localeCompare(right.fsn)
    );

    // Same-FSN reconciliation is global and always happens before foreign allocation.
    orderedPlans.forEach(plan => {
      const ownEntries = pool.filter(entry => entry.fsn === plan.fsn && entry.remaining > 0);
      const ownExcess = ownEntries.reduce((sum, entry) => sum + entry.remaining, 0);
      plan.sameFsnExcess = ownExcess;
      if (!ownExcess) return;
      plan.sameFsnUsed = consumeEntryUnits(ownEntries, Math.min(plan.originalShort, ownExcess));
      plan.remainingShort -= plan.sameFsnUsed;
      if (ownExcess === plan.originalShort) {
        plan.sameFsnExact = true;
      } else if (ownExcess > plan.originalShort) {
        plan.quantityConflict =
          'Same-FSN excess ' + ownExcess + ' exceeds short quantity ' + plan.originalShort + '.';
        ownEntries.forEach(entry => {
          if (entry.remaining > 0) entry.quarantinedReason = plan.quantityConflict;
        });
      }
    });

    const casePlans = orderedPlans.filter(plan => plan.isCaseFsn && !plan.isBulkFsn && !plan.sameFsnExact && !plan.quantityConflict);
    const nonCasePlans = orderedPlans.filter(plan => !plan.isCaseFsn && !plan.sameFsnExact && !plan.quantityConflict);
    const appendAllocationWarning = (plan, warning) => {
      plan.allocationWarning = unique([plan.allocationWarning, warning]).join(' ');
    };
    casePlans.forEach(plan => {
      if (plan.sameFsnUsed > 0) {
        plan.parallelSameFsnEvidence = true;
        plan.remainingShort = plan.originalShort;
      }
      plan.caseShortIsMultiple = wholeMultiple(plan.originalShort, plan.caseSize);
      if (plan.caseShortIsMultiple) {
        plan.caseCartonsRemaining = Math.floor(plan.originalShort / plan.caseSize);
      }
    });
    orderedPlans
      .filter(plan => !plan.sameFsnExact && !plan.quantityConflict)
      .forEach(plan => {
        if (plan.isCaseFsn && !plan.isBulkFsn && !plan.caseShortIsMultiple) return;
        const foreignEntries = pool.filter(
          entry => entry.remaining > 0 && entry.fsn !== plan.fsn
        );
        if (!foreignEntries.length) return;
        const quarantinedEntries = foreignEntries.filter(entry => entry.quarantinedReason);
        if (quarantinedEntries.length) {
          appendAllocationWarning(
            plan,
            'Foreign excess is quarantined by a Same-FSN quantity conflict: ' +
              unique(quarantinedEntries.map(entry => entry.fsn)).sort().join(', ') + '.'
          );
        }
        const usableForeignEntries = foreignEntries.filter(entry => !entry.quarantinedReason);
        if (!usableForeignEntries.length) return;
        const conflictingFsns = unique([
          context.verticalConflictFsns.has(plan.fsn) ? plan.fsn : '',
          ...usableForeignEntries
            .filter(entry => context.verticalConflictFsns.has(entry.fsn))
            .map(entry => entry.fsn)
        ]).sort();
        if (conflictingFsns.length) {
          appendAllocationWarning(
            plan,
            'Conflicting vertical metadata for FSN(s): ' + conflictingFsns.join(', ') + '.'
          );
        }
        if (!verticalKey(plan.vertical) || usableForeignEntries.some(entry => !verticalKey(entry.vertical))) {
          appendAllocationWarning(
            plan,
            'Vertical data is missing for a short/excess pairing; Mismatch versus Misshipment cannot be determined.'
          );
        }
      });

    const caseCandidateEntries = new Map();
    pool.forEach(entry => {
      if (
        entry.remaining > 0 &&
        !entry.quarantinedReason &&
        caseSizeByFsn.has(entry.fsn) &&
        !bulkFsns.has(entry.fsn)
      ) {
        if (!caseCandidateEntries.has(entry.fsn)) caseCandidateEntries.set(entry.fsn, []);
        caseCandidateEntries.get(entry.fsn).push(entry);
      }
    });
    Array.from(caseCandidateEntries.entries()).forEach(([candidateFsn]) => {
      const candidateCaseSize = caseSizeByFsn.get(candidateFsn);
      const originalUnits = context.excessEntries
        .filter(entry => entry.fsn === candidateFsn)
        .reduce((sum, entry) => sum + entry.original, 0);
      if (!wholeMultiple(originalUnits, candidateCaseSize)) {
        caseCandidateEntries.delete(candidateFsn);
      }
    });
    const feasibleCaseConsumers = casePlans.filter(plan => {
      return (
        plan.caseShortIsMultiple &&
        Array.from(caseCandidateEntries.entries()).some(([candidateFsn, entries]) => {
          return (
            candidateFsn !== plan.fsn &&
            verticalRelation(plan.vertical, entries[0].vertical) !== 'unknown'
          );
        })
      );
    });
    const availableCaseCartons = Array.from(caseCandidateEntries.entries()).reduce(
      (sum, [candidateFsn, entries]) => {
        const candidateCaseSize = caseSizeByFsn.get(candidateFsn);
        const availableUnits = entries.reduce((entrySum, entry) => entrySum + entry.remaining, 0);
        return sum + Math.floor(availableUnits / candidateCaseSize);
      },
      0
    );
    const demandedCaseCartons = feasibleCaseConsumers.reduce(
      (sum, plan) => sum + plan.caseCartonsRemaining,
      0
    );
    if (
      feasibleCaseConsumers.length > 1 &&
      availableCaseCartons > 0 &&
      availableCaseCartons < demandedCaseCartons
    ) {
      feasibleCaseConsumers.forEach(plan => {
        appendAllocationWarning(
          plan,
          'Ambiguous excess allocation: multiple complete-Case short FSNs compete for insufficient foreign cartons.'
        );
      });
    }
    caseCandidateEntries.forEach((entries, candidateFsn) => {
      const candidateCaseSize = caseSizeByFsn.get(candidateFsn);
      const availableUnits = entries.reduce((sum, entry) => sum + entry.remaining, 0);
      if (!wholeMultiple(availableUnits, candidateCaseSize)) return;
      const caseConsumers = casePlans.filter(plan => {
        return (
          plan.caseShortIsMultiple &&
          plan.fsn !== candidateFsn &&
          verticalRelation(plan.vertical, entries[0].vertical) !== 'unknown'
        );
      });
      const ordinaryConsumers = nonCasePlans.filter(plan => {
        return (
          plan.remainingShort > 0 &&
          plan.fsn !== candidateFsn &&
          verticalRelation(plan.vertical, entries[0].vertical) !== 'unknown'
        );
      });
      const caseDemandUnits = caseConsumers.reduce(
        (sum, plan) => sum + plan.caseCartonsRemaining * candidateCaseSize,
        0
      );
      const ordinaryDemandUnits = ordinaryConsumers.reduce(
        (sum, plan) => sum + plan.remainingShort,
        0
      );
      if (
        caseConsumers.length &&
        ordinaryConsumers.length &&
        availableUnits < caseDemandUnits + ordinaryDemandUnits
      ) {
        const warning =
          'Ambiguous excess allocation: Case and non-Case short FSNs compete for ' +
          candidateFsn + '.';
        [...caseConsumers, ...ordinaryConsumers].forEach(plan => {
          appendAllocationWarning(plan, warning);
        });
      }
    });

    const allocateCaseRelation = relation => {
      casePlans.forEach(plan => {
        if (!plan.caseShortIsMultiple || plan.caseCartonsRemaining <= 0) return;
        const entriesByCandidateFsn = new Map();
        pool.forEach(entry => {
          if (
            entry.remaining <= 0 ||
            entry.quarantinedReason ||
            entry.fsn === plan.fsn ||
            verticalRelation(plan.vertical, entry.vertical) !== relation ||
            !caseSizeByFsn.has(entry.fsn) ||
            bulkFsns.has(entry.fsn)
          ) return;
          if (!entriesByCandidateFsn.has(entry.fsn)) entriesByCandidateFsn.set(entry.fsn, []);
          entriesByCandidateFsn.get(entry.fsn).push(entry);
        });
        Array.from(entriesByCandidateFsn.entries())
          .sort(([left], [right]) => left.localeCompare(right))
          .forEach(([candidateFsn, entries]) => {
            if (plan.caseCartonsRemaining <= 0) return;
            const candidateCaseSize = caseSizeByFsn.get(candidateFsn);
            const originalCandidateExcess = context.excessEntries
              .filter(candidate => {
                return (
                  candidate.fsn === candidateFsn &&
                  verticalRelation(plan.vertical, candidate.vertical) === relation
                );
              })
              .reduce((sum, candidate) => sum + candidate.original, 0);
            if (!wholeMultiple(originalCandidateExcess, candidateCaseSize)) return;
            const availableUnits = entries.reduce((sum, entry) => sum + entry.remaining, 0);
            const availableCartons = Math.floor(availableUnits / candidateCaseSize);
            const cartons = Math.min(plan.caseCartonsRemaining, availableCartons);
            if (!cartons) return;
            const excessQuantity = cartons * candidateCaseSize;
            const targetQuantity = cartons * plan.caseSize;
            consumeEntryUnits(entries, excessQuantity);
            plan.caseCartonsRemaining -= cartons;
            plan.remainingShort = Math.max(0, plan.remainingShort - targetQuantity);
            const evidence = candidateEvidence(entries[0], excessQuantity, targetQuantity, cartons);
            if (relation === 'same') {
              plan.mismatchQuantity += targetQuantity;
              plan.mismatchCandidates.push(evidence);
            } else {
              plan.misshipmentQuantity += targetQuantity;
              plan.misshipmentCandidates.push(evidence);
            }
          });
      });
    };
    allocateCaseRelation('same');
    allocateCaseRelation('different');

    const targetOrder = nonCasePlans;
    const sameVerticalGroups = new Map();
    targetOrder.forEach(plan => {
      const vertical = verticalKey(plan.vertical);
      if (!vertical || plan.remainingShort <= 0) return;
      if (!sameVerticalGroups.has(vertical)) sameVerticalGroups.set(vertical, []);
      sameVerticalGroups.get(vertical).push(plan);
    });
    sameVerticalGroups.forEach((consumers, vertical) => {
      if (consumers.length <= 1) return;
      const supply = pool
        .filter(entry => {
          return (
            entry.remaining > 0 &&
            !entry.quarantinedReason &&
            verticalKey(entry.vertical) === vertical
          );
        })
        .reduce((sum, entry) => sum + entry.remaining, 0);
      const demand = consumers.reduce((sum, plan) => sum + plan.remainingShort, 0);
      if (supply > 0 && supply < demand) {
        consumers.forEach(plan => {
          appendAllocationWarning(
            plan,
            'Ambiguous excess allocation: multiple same-vertical short FSNs compete for insufficient excess.'
          );
        });
      }
    });
    const allocateForeignRelation = relation => {
      targetOrder.forEach(plan => {
        if (plan.remainingShort <= 0) return;
        pool.forEach(entry => {
          if (
            plan.remainingShort <= 0 ||
            entry.remaining <= 0 ||
            entry.quarantinedReason ||
            entry.fsn === plan.fsn
          ) return;
          if (verticalRelation(plan.vertical, entry.vertical) !== relation) return;
          const used = Math.min(plan.remainingShort, entry.remaining);
          entry.remaining -= used;
          plan.remainingShort -= used;
          const evidence = candidateEvidence(entry, used);
          if (relation === 'same') {
            plan.mismatchQuantity += used;
            plan.mismatchCandidates.push(evidence);
          } else {
            plan.misshipmentQuantity += used;
            plan.misshipmentCandidates.push(evidence);
          }
        });
      });
    };
    allocateForeignRelation('same');
    const differentVerticalConsumers = targetOrder.filter(plan => {
      if (plan.remainingShort <= 0) return false;
      return pool.some(entry => {
        return (
          entry.remaining > 0 &&
          !entry.quarantinedReason &&
          entry.fsn !== plan.fsn &&
          verticalRelation(plan.vertical, entry.vertical) === 'different'
        );
      });
    });
    const differentVerticalSupply = pool
      .filter(entry => entry.remaining > 0 && !entry.quarantinedReason)
      .reduce((sum, entry) => sum + entry.remaining, 0);
    const differentVerticalDemand = differentVerticalConsumers.reduce(
      (sum, plan) => sum + plan.remainingShort,
      0
    );
    if (
      differentVerticalConsumers.length > 1 &&
      differentVerticalSupply > 0 &&
      differentVerticalSupply < differentVerticalDemand
    ) {
      differentVerticalConsumers.forEach(plan => {
        appendAllocationWarning(
          plan,
          'Ambiguous excess allocation: multiple cross-vertical short FSNs compete for insufficient excess.'
        );
      });
    }
    allocateForeignRelation('different');

    orderedPlans.forEach(plan => {
      plan.unexplainedQuantity = Math.max(plan.remainingShort, 0);
      delete plan.remainingShort;
      delete plan.caseCartonsRemaining;
    });
    if (!options.skipAmbiguityAudit) {
      const alternatePlans = buildBoxReconciliationPlan(
        context,
        caseSizeByFsn,
        bulkFsns,
        { reverseTargets: !options.reverseTargets, skipAmbiguityAudit: true }
      );
      plans.forEach((plan, fsn) => {
        const alternate = alternatePlans.get(fsn);
        if (alternate && planOutcomeSignature(plan) !== planOutcomeSignature(alternate)) {
          plan.allocationWarning = unique([
            plan.allocationWarning,
            'Ambiguous excess allocation: competing short FSNs change this result when target priority is reversed.'
          ]).join(' ');
        }
      });
      context.unallocatedExcess = pool
        .filter(entry => entry.remaining > 0)
        .map(entry => candidateEvidence(entry, entry.remaining));
      const originalExcess = pool.reduce((sum, entry) => sum + entry.original, 0);
      const unallocatedExcess = pool.reduce((sum, entry) => sum + entry.remaining, 0);
      const accountedAllocatedExcess = orderedPlans.reduce((sum, plan) => {
        const foreign = [...plan.mismatchCandidates, ...plan.misshipmentCandidates]
          .reduce((candidateSum, candidate) => candidateSum + candidate.quantity, 0);
        return sum + plan.sameFsnUsed + foreign;
      }, 0);
      context.excessConservation = {
        originalExcess,
        allocatedExcess: originalExcess - unallocatedExcess,
        accountedAllocatedExcess,
        unallocatedExcess,
        balanced: originalExcess === accountedAllocatedExcess + unallocatedExcess
      };
    }
    return plans;
  }

  function isColdTemperature(value) {
    const temperature = exactText(value).toLowerCase();
    if (!temperature) return false;
    if (['na', 'n/a', 'ambient', 'normal', 'dry'].includes(temperature)) return false;
    return /freez|chill|cold|temp\s*range|temprange/.test(temperature);
  }

  function classifyCold(locationValue, temperatureValue) {
    const location = exactText(locationValue).toUpperCase();
    if (location) {
      return {
        known: true,
        cold: /^(AM|FZ|CH)/.test(location),
        source: 'Sheet Z location'
      };
    }
    const temperature = exactText(temperatureValue);
    if (temperature) {
      return {
        known: true,
        cold: isColdTemperature(temperature),
        source: 'IWIT/MWIT taxonomy temperature'
      };
    }
    return { known: false, cold: false, source: 'Unknown' };
  }

  function parseOutbound(body) {
    const flowRaw = deepField(body, ['picking_reference_type', 'pickingReferenceType', 'planType'], 4);
    const tlId = exactText(
      deepField(body, ['picking_reference_id', 'pickingReferenceId'], 4)
    );
    const shipmentAttributes = deepField(body, ['shipment_attributes', 'shipmentAttributes'], 4);
    const consignment = exactText(
      directField(shipmentAttributes, ['group_id', 'groupId']) ??
        deepField(body, ['consignmentId', 'consignment_id', 'groupId', 'group_id'], 4)
    );
    return {
      flow: normalizeFlow(flowRaw),
      flowRaw: exactText(flowRaw),
      tlId,
      consignment,
      schemaWarning: normalizeFlow(flowRaw) ? '' : 'Outbound response did not expose a recognised PBD/P&S type.'
    };
  }

  function weightKilograms(value, unitValue = '') {
    const weight = finiteNumber(value, null);
    if (weight === null) return null;
    const unit = exactText(unitValue).toUpperCase().replace(/[^A-Z]/g, '');
    if (!unit || ['KG', 'KGS', 'KILOGRAM', 'KILOGRAMS'].includes(unit)) return weight;
    if (['G', 'GM', 'GMS', 'GRAM', 'GRAMS'].includes(unit)) return weight / 1000;
    if (['MG', 'MILLIGRAM', 'MILLIGRAMS'].includes(unit)) return weight / 1000000;
    return null;
  }

  function parseTitleWeightKilograms(titleValue) {
    const productTitle = exactText(titleValue);
    const rejected = reason => ({
      productTitle,
      weightKg: null,
      method: '',
      rejection: reason
    });
    if (!productTitle) return rejected('missing-title');

    const title = productTitle
      .replace(/\u00a0/g, ' ')
      .replace(/[\u00d7\u2715]/g, 'x')
      .replace(/[\u2013\u2014]/g, '-');
    const unitPattern = '(?:kgs?|kilograms?|g|gms?|grams?)';
    const massPattern = '(\\d+(?:\\.\\d+)?)\\s*(' + unitPattern + ')';
    const massRegex = new RegExp(massPattern, 'gi');
    const massMatches = Array.from(title.matchAll(massRegex));
    if (!massMatches.length) return rejected('no-supported-mass');

    const riskyContext =
      /\b(?:capacity|maximum\s+load|load\s+capacity|up\s+to|suitable\s+for)\b/i.test(title) ||
      /\b(?:washing\s+machine|washer|dryer)\b/i.test(title) ||
      (/\b(?:baby|babies|infant|newborn)\b/i.test(title) && massMatches.length > 0);
    if (riskyContext) return rejected('risky-capacity-context');

    const rangeRegex = new RegExp(
      '\\b\\d+(?:\\.\\d+)?\\s*(?:-|to)\\s*\\d+(?:\\.\\d+)?\\s*' + unitPattern + '\\b',
      'i'
    );
    if (rangeRegex.test(title)) return rejected('mass-range');
    if (massMatches.length !== 1) return rejected('multiple-masses');

    const match = massMatches[0];
    const unitWeightKg = weightKilograms(match[1], match[2]);
    if (!Number.isFinite(unitWeightKg) || unitWeightKg <= 0) {
      return rejected('invalid-mass');
    }

    const before = title.slice(0, match.index);
    const after = title.slice((match.index || 0) + match[0].length);
    const multiplierMatches = [
      before.match(/(\d+)\s*x\s*$/i),
      after.match(/^\s*x\s*(\d+)\b/i),
      after.match(/^\s*[\(\[\{,\-:]?\s*pack\s+of\s+(\d+)\b/i),
      before.match(/\bpack\s+of\s+(\d+)\s*(?:x\s*)?$/i)
    ].filter(Boolean);
    if (multiplierMatches.length > 1) return rejected('ambiguous-multipack');

    const multiplier = multiplierMatches.length
      ? finiteNumber(multiplierMatches[0][1], null)
      : 1;
    if (!Number.isInteger(multiplier) || multiplier <= 0) {
      return rejected('invalid-multipack');
    }
    return {
      productTitle,
      weightKg: unitWeightKg * multiplier,
      method: multiplier === 1 ? 'single-mass' : 'multipack',
      rejection: ''
    };
  }

  function normalisePhysicalItem(item) {
    const sourceLocationValue =
      itemField(item, ['sourceLocation', 'source_location']) ??
      itemField(item, ['location', 'storageLocation'], true);
    const volume = finiteNumber(itemField(item, ['volume', 'itemVolume'], true), null);
    const rawWeight = finiteNumber(itemField(item, ['weight', 'itemWeight'], true), null);
    const weightUnit = exactText(
      itemField(item, ['weightUnit', 'weight_unit', 'itemWeightUnit'], true)
    );
    const weight = weightKilograms(rawWeight, weightUnit);
    const productTitle = exactText(
      itemField(item, ['productTitle', 'product_title'], true)
    );
    const titleWeight = parseTitleWeightKilograms(productTitle);
    const imageUrl = itemImageUrl(item);
    const quantity = positiveNumber(itemField(item, ['quantity', 'qty', 'itemQuantity'], true), 1);
    return {
      fsn: exactText(itemField(item, ['fsn', 'FSN'], true)),
      wid: exactText(itemField(item, ['wid', 'WID'], true)),
      quantity,
      status: exactText(itemField(item, ['status', 'itemStatus'], true)),
      sourceLocation: locationLabel(sourceLocationValue),
      destination: scalarIdentifier(itemField(item, ['destination', 'destinationPartyId', 'destinationLocationId'], true)),
      externalReferenceId: exactText(itemField(item, ['externalReferenceId', 'external_reference_id'], true)),
      volume,
      weight,
      rawWeight,
      weightUnit: weightUnit || PHYSICAL_LIMITS.mappingWeightUnit,
      productTitle,
      titleWeight: titleWeight.weightKg,
      titleWeightMethod: titleWeight.method,
      titleWeightRejection: titleWeight.rejection,
      imageUrl,
      imageSource: imageUrl ? 'Mapping/TL' : '',
      raw: item
    };
  }

  function physicalSummary(items) {
    let totalQuantity = 0;
    let volumeQuantityCovered = 0;
    let weightQuantityCovered = 0;
    let titleWeightQuantityCovered = 0;
    let effectiveWeightQuantityCovered = 0;
    let totalVolume = 0;
    let totalWeight = 0;
    let titleDerivedTotalWeight = 0;
    let effectiveTotalWeight = 0;

    items.forEach(item => {
      const quantity = positiveNumber(item.quantity, 1);
      totalQuantity += quantity;
      if (Number.isFinite(item.volume)) {
        totalVolume += item.volume * quantity;
        volumeQuantityCovered += quantity;
      }
      if (Number.isFinite(item.weight)) {
        totalWeight += item.weight * quantity;
        weightQuantityCovered += quantity;
      }
      if (Number.isFinite(item.titleWeight)) {
        titleDerivedTotalWeight += item.titleWeight * quantity;
        titleWeightQuantityCovered += quantity;
        effectiveTotalWeight += item.titleWeight * quantity;
        effectiveWeightQuantityCovered += quantity;
      } else if (Number.isFinite(item.weight)) {
        effectiveTotalWeight += item.weight * quantity;
        effectiveWeightQuantityCovered += quantity;
      }
    });

    const knownTotalVolume = volumeQuantityCovered ? totalVolume : null;
    const knownTotalWeight = weightQuantityCovered ? totalWeight : null;
    const knownTitleWeight = titleWeightQuantityCovered ? titleDerivedTotalWeight : null;
    const knownEffectiveWeight = effectiveWeightQuantityCovered ? effectiveTotalWeight : null;
    const effectiveWeightSource = titleWeightQuantityCovered
      ? titleWeightQuantityCovered === effectiveWeightQuantityCovered
        ? 'Product title'
        : 'Product title + API fallback'
      : weightQuantityCovered
        ? 'API weight'
        : '';
    return {
      itemLines: items.length,
      totalQuantity,
      totalVolume: knownTotalVolume,
      totalWeight: knownTotalWeight,
      titleDerivedTotalWeight: knownTitleWeight,
      effectiveTotalWeight: knownEffectiveWeight,
      volumeCoverage: totalQuantity ? volumeQuantityCovered / totalQuantity : 0,
      weightCoverage: totalQuantity ? weightQuantityCovered / totalQuantity : 0,
      titleWeightCoverage: totalQuantity ? titleWeightQuantityCovered / totalQuantity : 0,
      effectiveWeightCoverage: totalQuantity ? effectiveWeightQuantityCovered / totalQuantity : 0,
      titleWeightQuantityCovered,
      effectiveWeightQuantityCovered,
      effectiveWeightSource,
      toteVolumeLimitCm3: PHYSICAL_LIMITS.toteVolumeCm3,
      toteWeightLimitKg: PHYSICAL_LIMITS.toteWeightKg,
      volumeUtilization:
        knownTotalVolume === null ? null : knownTotalVolume / PHYSICAL_LIMITS.toteVolumeCm3,
      weightUtilization:
        knownTotalWeight === null ? null : knownTotalWeight / PHYSICAL_LIMITS.toteWeightKg,
      effectiveWeightUtilization:
        knownEffectiveWeight === null
          ? null
          : knownEffectiveWeight / PHYSICAL_LIMITS.toteWeightKg,
      volumeLimitExceeded:
        knownTotalVolume !== null && knownTotalVolume > PHYSICAL_LIMITS.toteVolumeCm3,
      weightLimitExceeded:
        knownEffectiveWeight !== null && knownEffectiveWeight >= PHYSICAL_LIMITS.toteWeightKg
    };
  }

  function overlayExactBoxTitleWeight(basePhysical, exactBoxTlPhysical) {
    if (!exactBoxTlPhysical?.titleWeightQuantityCovered) return basePhysical;
    return {
      ...basePhysical,
      titleDerivedTotalWeight: exactBoxTlPhysical.titleDerivedTotalWeight,
      effectiveTotalWeight: exactBoxTlPhysical.effectiveTotalWeight,
      titleWeightCoverage: exactBoxTlPhysical.titleWeightCoverage,
      effectiveWeightCoverage: exactBoxTlPhysical.effectiveWeightCoverage,
      titleWeightQuantityCovered: exactBoxTlPhysical.titleWeightQuantityCovered,
      effectiveWeightQuantityCovered: exactBoxTlPhysical.effectiveWeightQuantityCovered,
      effectiveWeightSource: 'Exact-box TL ' + exactBoxTlPhysical.effectiveWeightSource.toLowerCase(),
      effectiveWeightUtilization: exactBoxTlPhysical.effectiveWeightUtilization,
      weightLimitExceeded: exactBoxTlPhysical.weightLimitExceeded
    };
  }

  function parseMapping(body) {
    const rawItems = firstArray(body, ['itemDetails', 'item_details']);
    const boxDetail = deepField(body, ['boxDetail', 'box_detail'], 4);
    const items = rawItems.map(item => {
      const physical = normalisePhysicalItem(item);
      return {
        ...physical,
        imageSource: physical.imageUrl ? 'P&S mapping' : '',
        inputContainerId: scalarIdentifier(
          itemField(item, ['inputContainerId', 'input_container_id', 'inputContainer'], true)
        ),
        tlId: exactText(itemField(item, ['externalReferenceId', 'external_reference_id'], true))
      };
    });
    return {
      outputExternalReferenceId: exactText(
        directField(boxDetail, ['externalReferenceId', 'external_reference_id']) ??
          deepField(body, ['outputExternalReferenceId'], 4)
      ),
      items,
      inputBoxes: unique(items.map(item => item.inputContainerId)),
      tlIds: unique([
        ...items.map(item => item.tlId).filter(looksLikeTlId),
        ...collectTlIds(body)
      ]),
      summary: physicalSummary(items),
      schemaWarning: rawItems.length ? '' : 'Input/output mapping response did not expose itemDetails.'
    };
  }

  function normaliseTlItem(item, responseIndex, containerLabelById) {
    const physical = normalisePhysicalItem(item);
    const sourceLocationValue =
      itemField(item, ['sourceLocation', 'source_location']) ??
      itemField(item, ['location', 'storageLocation'], true);
    const destinationLocationId = scalarIdentifier(
      itemField(item, ['destinationLocationId', 'destination_location_id', 'containerId'], true)
    );
    const directDestinationLabel = scalarIdentifier(
      itemField(item, ['destinationContainerLabel', 'destinationBoxId', 'boxId'], true)
    );
    return {
      responseIndex,
      tlUnitSequence: responseIndex + 1,
      itemId: scalarIdentifier(itemField(item, ['id', 'picklistItemId', 'picklist_item_id'])),
      fsn: physical.fsn,
      wid: physical.wid,
      ean: exactText(itemField(item, ['ean', 'EAN'], true)),
      quantity: physical.quantity,
      volume: physical.volume,
      weight: physical.weight,
      rawWeight: physical.rawWeight,
      weightUnit: physical.weightUnit,
      productTitle: physical.productTitle,
      titleWeight: physical.titleWeight,
      titleWeightMethod: physical.titleWeightMethod,
      titleWeightRejection: physical.titleWeightRejection,
      imageUrl: physical.imageUrl,
      imageSource: physical.imageUrl ? 'TL' : '',
      rawPickSequence: itemField(item, ['pickSequence', 'pick_sequence'], true),
      locationSequence: itemField(item, ['locationSequence', 'location_sequence'], true),
      sourceLocation: locationLabel(sourceLocationValue),
      destinationLocationId,
      destinationBox: containerLabelById.get(destinationLocationId) || directDestinationLabel,
      destinationPartyId: scalarIdentifier(
        itemField(item, ['destinationPartyId', 'destination_party_id'], true)
      ),
      isBulkPickingEnabled: booleanValue(
        itemField(item, ['isBulkPickingEnabled', 'bulkPickingEnabled'], true)
      ),
      raw: item
    };
  }

  function parseTl(body, tlId = '') {
    const rawContainers = firstArray(body, ['containerDetails', 'container_details']);
    const containers = rawContainers.map(container => ({
      id: scalarIdentifier(directField(container, ['id', 'containerId', 'container_id'])),
      label: exactText(directField(container, ['label', 'containerLabel', 'boxId'])),
      status: exactText(directField(container, ['status', 'containerStatus'])),
      isDropped: booleanValue(directField(container, ['isDropped', 'dropped'])),
      isManualCloseEnabled: booleanValue(
        directField(container, ['isManualCloseEnabled', 'manualCloseEnabled'])
      ),
      groupIds: (() => {
        const value = directField(container, ['groupIds', 'group_ids']);
        return Array.isArray(value) ? value.map(exactText) : value ? [exactText(value)] : [];
      })()
    }));
    const containerLabelById = new Map(
      containers.filter(container => container.id).map(container => [container.id, container.label])
    );
    const orderedPicklistArrays = findArrays(body, [
      'picklistItems',
      'pickListItems',
      'picklist_items'
    ]);
    const fallbackItemArrays = orderedPicklistArrays.length
      ? []
      : findArrays(body, ['itemDetails', 'pickItems']);
    const rawItems = Array.from(
      new Set((orderedPicklistArrays.length ? orderedPicklistArrays : fallbackItemArrays).flat())
    );
    const items = rawItems.map((item, index) => normaliseTlItem(item, index, containerLabelById));
    return {
      tlId,
      planType: normalizeFlow(deepField(body, ['planType', 'plan_type'], 4)),
      assignedTo: scalarIdentifier(deepField(body, ['assignedTo', 'assigned_to', 'pickerId'], 4)),
      completedItemCount: finiteNumber(
        deepField(body, ['completedItemCount', 'completed_item_count', 'completedItems'], 4),
        null
      ),
      externalGroupIds: (() => {
        const value = deepField(body, ['externalGroupIds', 'external_group_ids', 'groupIds'], 4);
        return Array.isArray(value) ? value.map(exactText) : value ? [exactText(value)] : [];
      })(),
      externalOrderIds: (() => {
        const value = deepField(body, ['externalOrderIds', 'external_order_ids', 'orderIds'], 4);
        return Array.isArray(value) ? value.map(exactText) : value ? [exactText(value)] : [];
      })(),
      containers,
      items,
      schemaWarning: rawItems.length ? '' : 'TL response did not expose picklist item details.'
    };
  }

  function sequenceNumber(value) {
    const parsed = finiteNumber(value, null);
    return Number.isFinite(parsed) ? parsed : null;
  }

  function compareTlItems(left, right) {
    return left.tlUnitSequence - right.tlUnitSequence;
  }

  function compactTlEvent(item) {
    return [
      'FSN=' + (item.fsn || '?'),
      'qty=' + item.quantity,
      'tlUnit=' + exactText(item.tlUnitSequence || '?'),
      'rawPick=' + exactText(item.rawPickSequence || '?'),
      'locSeq=' + exactText(item.locationSequence || '?'),
      'loc=' + (item.sourceLocation || '?'),
      'box=' + (item.destinationBox || item.destinationLocationId || '?')
    ].join(', ');
  }

  function analyseTlPath(targetFsn, targetBoxId, candidateFsns, tlIds, tlById) {
    const normalTargetFsn = fsnKey(targetFsn);
    const candidateSet = new Set(candidateFsns.map(fsnKey));
    const targetEvents = [];
    const candidateEvents = [];
    const neighbours = [];
    const pickers = [];
    const sourceLocations = [];
    const destinationBoxes = [];
    const tlUnitSequences = [];
    const rawPickSequences = [];
    const locationSequences = [];
    const containerEvidence = [];
    const boxPhysicalItems = [];
    const warnings = [];
    let minimumCandidatePickDistance = null;
    let sameSourceLocationCandidate = false;
    let adjacentLocationSequenceCandidate = false;
    let bulkQuantityEvent = false;

    tlIds.forEach(tlId => {
      const tl = tlById.get(tlId);
      if (!tl) {
        warnings.push('TL ' + tlId + ' was unavailable.');
        return;
      }
      if (tl.schemaWarning) warnings.push('TL ' + tlId + ': ' + tl.schemaWarning);
      if (tl.assignedTo) pickers.push(tl.assignedTo);
      tl.containers
        .filter(container => container.label === targetBoxId)
        .forEach(container => {
          containerEvidence.push(
            [
              'TL=' + tlId,
              'status=' + (container.status || '?'),
              'dropped=' + String(container.isDropped),
              'manualClose=' + String(container.isManualCloseEnabled),
              'groups=' + container.groupIds.join(',')
            ].join(', ')
          );
        });

      const sorted = [...tl.items].sort(compareTlItems);
      sorted
        .filter(item => item.destinationBox === targetBoxId)
        .forEach(item => {
          boxPhysicalItems.push({
            quantity: item.quantity,
            volume: item.volume,
            weight: item.weight,
            titleWeight: item.titleWeight
          });
        });
      const localTargets = [];
      const localCandidates = [];
      sorted.forEach((item, index) => {
        const itemFsn = fsnKey(item.fsn);
        if (itemFsn === normalTargetFsn) {
          const event = { tlId, index, item };
          localTargets.push(event);
          targetEvents.push(event);
          if (item.sourceLocation) sourceLocations.push(item.sourceLocation);
          if (item.destinationBox) destinationBoxes.push(item.destinationBox);
          tlUnitSequences.push(item.tlUnitSequence);
          if (item.rawPickSequence !== undefined) {
            rawPickSequences.push(exactText(item.rawPickSequence));
          }
          if (item.locationSequence !== undefined) locationSequences.push(exactText(item.locationSequence));
          if (item.quantity > 1 || item.isBulkPickingEnabled === true) bulkQuantityEvent = true;
          const previous = sorted[index - 1];
          const next = sorted[index + 1];
          if (previous) neighbours.push('TL ' + tlId + ' previous: ' + compactTlEvent(previous));
          if (next) neighbours.push('TL ' + tlId + ' next: ' + compactTlEvent(next));
        }
        if (candidateSet.has(itemFsn)) {
          const event = { tlId, index, item };
          localCandidates.push(event);
          candidateEvents.push(event);
        }
      });

      localTargets.forEach(target => {
        localCandidates.forEach(candidate => {
          const targetPick = sequenceNumber(target.item.tlUnitSequence);
          const candidatePick = sequenceNumber(candidate.item.tlUnitSequence);
          if (targetPick !== null && candidatePick !== null) {
            const distance = Math.abs(targetPick - candidatePick);
            if (minimumCandidatePickDistance === null || distance < minimumCandidatePickDistance) {
              minimumCandidatePickDistance = distance;
            }
          }
          if (
            target.item.sourceLocation &&
            candidate.item.sourceLocation &&
            target.item.sourceLocation === candidate.item.sourceLocation
          ) {
            sameSourceLocationCandidate = true;
          }
          const targetLoc = sequenceNumber(target.item.locationSequence);
          const candidateLoc = sequenceNumber(candidate.item.locationSequence);
          if (targetLoc !== null && candidateLoc !== null && Math.abs(targetLoc - candidateLoc) <= 1) {
            adjacentLocationSequenceCandidate = true;
          }
        });
      });
    });

    const targetInExactBox = targetEvents.some(event => event.item.destinationBox === targetBoxId);
    return {
      targetEventCount: targetEvents.length,
      candidateEventCount: candidateEvents.length,
      targetInExactBox,
      pickers: unique(pickers),
      sourceLocations: unique(sourceLocations),
      destinationBoxes: unique(destinationBoxes),
      tlUnitSequences: unique(tlUnitSequences),
      rawPickSequences: unique(rawPickSequences),
      locationSequences: unique(locationSequences),
      neighbours: unique(neighbours).slice(0, 8),
      minimumCandidatePickDistance,
      sameSourceLocationCandidate,
      adjacentLocationSequenceCandidate,
      bulkQuantityEvent,
      containerEvidence: unique(containerEvidence),
      physical: physicalSummary(boxPhysicalItems),
      warnings: unique(warnings)
    };
  }

  function firstImageForFsn(items, targetFsn, source, preferredBoxId = '') {
    const key = fsnKey(targetFsn);
    if (!key) return { fsn: '', url: '', source: '' };
    const matches = (items || []).filter(
      item => fsnKey(item.fsn) === key && normaliseImageUrl(item.imageUrl)
    );
    if (preferredBoxId) {
      matches.sort(
        (left, right) =>
          Number(right.destinationBox === preferredBoxId) -
          Number(left.destinationBox === preferredBoxId)
      );
    }
    const match = matches[0];
    return match
      ? {
          fsn: exactText(match.fsn) || exactText(targetFsn),
          url: normaliseImageUrl(match.imageUrl),
          source: exactText(match.imageSource) || source
        }
      : { fsn: exactText(targetFsn), url: '', source: '' };
  }

  function resolveProductImages(
    decision,
    allocationContext,
    mappingItems,
    tlIds,
    tlById
  ) {
    const targetFsn = decision.row.fsn;
    const targetKey = fsnKey(targetFsn);
    const tlItems = tlIds.flatMap(tlId => tlById.get(tlId)?.items || []);
    const meta = allocationContext?.metaByFsn.get(targetKey);
    let expected = {
      fsn: targetFsn,
      url: normaliseImageUrl(meta?.imageUrl),
      source: meta?.imageUrl ? exactText(meta.imageSource) || 'IWIT/MWIT expected item' : ''
    };
    if (!expected.url) {
      expected = firstImageForFsn(tlItems, targetFsn, 'TL', decision.row.boxId);
    }
    if (!expected.url) {
      expected = firstImageForFsn(mappingItems, targetFsn, 'P&S mapping');
    }

    const allocatedCandidates = [
      ...(decision.mismatchCandidates || []),
      ...(decision.misshipmentCandidates || [])
    ];
    let excessCandidate = allocatedCandidates[0] || null;
    if (!excessCandidate && decision.sameFsnExact) {
      excessCandidate = (allocationContext?.excessEntries || [])
        .filter(entry => entry.fsn === targetKey)
        .sort(excessEntryOrder)[0] || null;
    }
    if (!excessCandidate && decision.packslipConfirmed) {
      excessCandidate = [...(allocationContext?.excessEntries || [])]
        .sort(excessEntryOrder)[0] || null;
    }

    const excessFsn = exactText(excessCandidate?.fsn || excessCandidate?.displayFsn);
    let excess = {
      fsn: excessFsn,
      url: normaliseImageUrl(excessCandidate?.imageUrl),
      source: excessCandidate?.imageUrl
        ? exactText(excessCandidate.imageSource) || 'IWIT/MWIT excess item'
        : ''
    };
    if (excessFsn && !excess.url) {
      excess = firstImageForFsn(mappingItems, excessFsn, 'P&S mapping');
    }
    if (excessFsn && !excess.url) {
      excess = firstImageForFsn(tlItems, excessFsn, 'TL', decision.row.boxId);
    }

    return { expected, excess };
  }

  function emptyTlNeighbour(direction) {
    return {
      direction,
      found: false,
      tlId: '',
      itemId: '',
      fsn: '',
      productTitle: '',
      url: '',
      source: '',
      tlUnitSequence: null,
      rawPickSequence: '',
      locationSequence: '',
      sourceLocation: '',
      destinationBox: ''
    };
  }

  function tlNeighbourDetail(item, tlId, direction) {
    if (!item) return emptyTlNeighbour(direction);
    const url = normaliseImageUrl(item.imageUrl);
    return {
      direction,
      found: true,
      tlId: exactText(tlId),
      itemId: exactText(item.itemId),
      fsn: exactText(item.fsn),
      productTitle: exactText(item.productTitle),
      url,
      source: url ? 'TL ' + direction + ' neighbour' : '',
      tlUnitSequence: sequenceNumber(item.tlUnitSequence),
      rawPickSequence: exactText(item.rawPickSequence),
      locationSequence: exactText(item.locationSequence),
      sourceLocation: exactText(item.sourceLocation),
      destinationBox: exactText(item.destinationBox || item.destinationLocationId)
    };
  }

  function tlTargetBlocks(tlIds, tlById, targetKey, destinationScope, matchScope) {
    const blocks = [];
    const scope = destinationScope instanceof Set ? destinationScope : null;
    tlIds.forEach(tlId => {
      const tl = tlById.get(tlId);
      if (!tl) return;
      const items = [...(tl.items || [])].sort(compareTlItems);
      let active = null;
      items.forEach((item, index) => {
        const destination = exactText(item.destinationBox || item.destinationLocationId);
        const matches =
          fsnKey(item.fsn) === targetKey &&
          (!scope || scope.has(destination));
        if (!matches) {
          active = null;
          return;
        }
        if (active && active.endIndex === index - 1) {
          active.endIndex = index;
          active.items.push(item);
          return;
        }
        active = {
          tlId,
          matchScope,
          sortedItems: items,
          startIndex: index,
          endIndex: index,
          items: [item]
        };
        blocks.push(active);
      });
    });
    return blocks;
  }

  /**
   * Resolve visual neighbours from the one-row-per-unit TL list. The raw API
   * pickSequence is intentionally not used because it is frequently 1 for all
   * units. Multiple possible target blocks fail closed instead of guessing.
   */
  function resolveTlNeighbourImages(
    targetFsn,
    targetBoxId,
    mappedInputBoxes,
    tlIds,
    tlById
  ) {
    const result = {
      status: 'target-not-found',
      matchScope: '',
      note: 'Target FSN was not found in the available TL unit rows.',
      target: {
        tlId: '',
        blockStart: null,
        blockEnd: null,
        unitCount: 0,
        destinationBoxes: []
      },
      previous: emptyTlNeighbour('previous'),
      next: emptyTlNeighbour('next')
    };
    const targetKey = fsnKey(targetFsn);
    const availableTlIds = unique(tlIds || []).filter(tlId => tlById.has(tlId));
    if (!targetKey || !availableTlIds.length) {
      result.status = availableTlIds.length ? 'target-not-found' : 'tl-unavailable';
      result.note = availableTlIds.length
        ? result.note
        : 'No parsed TL response was available for neighbour images.';
      return result;
    }

    const exactBox = exactText(targetBoxId);
    let blocks = exactBox
      ? tlTargetBlocks(
          availableTlIds,
          tlById,
          targetKey,
          new Set([exactBox]),
          'Exact target Box ID'
        )
      : [];

    if (!blocks.length) {
      const mappedScope = new Set(unique(mappedInputBoxes || []).map(exactText));
      if (mappedScope.size) {
        blocks = tlTargetBlocks(
          availableTlIds,
          tlById,
          targetKey,
          mappedScope,
          'P&S mapped input Box ID'
        );
      }
    }

    if (!blocks.length) {
      const unscoped = tlTargetBlocks(
        availableTlIds,
        tlById,
        targetKey,
        null,
        'Unique TL target fallback'
      );
      const unscopedUnitCount = unscoped.reduce((sum, block) => sum + block.items.length, 0);
      if (unscoped.length === 1 && unscopedUnitCount === 1) {
        blocks = unscoped;
      } else if (unscoped.length || unscopedUnitCount) {
        result.status = 'ambiguous';
        result.note =
          'Target FSN did not resolve to the target/mapped Box and appears in ' +
          unscoped.length + ' TL block(s); neighbour images were withheld.';
        return result;
      }
    }

    if (!blocks.length) return result;
    if (blocks.length !== 1) {
      result.status = 'ambiguous';
      result.matchScope = blocks[0].matchScope;
      result.note =
        blocks.length + ' matching target blocks were found in ' +
        blocks[0].matchScope + '; neighbour images were withheld to avoid guessing.';
      return result;
    }

    const block = blocks[0];
    const targetItems = block.items;
    const targetDestinations = unique(
      targetItems.map(item => exactText(item.destinationBox || item.destinationLocationId))
    );
    let previousIndex = block.startIndex - 1;
    while (
      previousIndex >= 0 &&
      fsnKey(block.sortedItems[previousIndex]?.fsn) === targetKey
    ) previousIndex -= 1;
    let nextIndex = block.endIndex + 1;
    while (
      nextIndex < block.sortedItems.length &&
      fsnKey(block.sortedItems[nextIndex]?.fsn) === targetKey
    ) nextIndex += 1;

    result.status = 'resolved';
    result.matchScope = block.matchScope;
    result.note = block.matchScope === 'Unique TL target fallback'
      ? 'Exact Box mapping was unavailable; the only target unit in the TL was used.'
      : '';
    result.target = {
      tlId: block.tlId,
      blockStart: sequenceNumber(targetItems[0]?.tlUnitSequence),
      blockEnd: sequenceNumber(targetItems[targetItems.length - 1]?.tlUnitSequence),
      unitCount: targetItems.length,
      destinationBoxes: targetDestinations
    };
    result.previous = tlNeighbourDetail(
      previousIndex >= 0 ? block.sortedItems[previousIndex] : null,
      block.tlId,
      'previous'
    );
    result.next = tlNeighbourDetail(
      nextIndex < block.sortedItems.length ? block.sortedItems[nextIndex] : null,
      block.tlId,
      'next'
    );
    return result;
  }

  function normaliseShortUnitQuotas(shortUnitsByFsn) {
    const quotas = new Map();
    if (shortUnitsByFsn instanceof Map) {
      shortUnitsByFsn.forEach((quantity, fsn) => {
        const units = Math.max(0, Math.floor(finiteNumber(quantity, 0)));
        const key = fsnKey(fsn);
        if (key && units) quotas.set(key, (quotas.get(key) || 0) + units);
      });
      return quotas;
    }
    Array.from(shortUnitsByFsn || []).forEach(fsn => {
      const key = fsnKey(fsn);
      if (key) quotas.set(key, (quotas.get(key) || 0) + 1);
    });
    return quotas;
  }

  function shortestQuotaWindow(events, quotaByFsn, targetUnitCount) {
    const counts = new Map();
    let coveredUnits = 0;
    let left = 0;
    let best = null;
    events.forEach((event, right) => {
      const fsn = fsnKey(event.item.fsn);
      const previousCount = counts.get(fsn) || 0;
      counts.set(fsn, previousCount + 1);
      if (previousCount < (quotaByFsn.get(fsn) || 0)) coveredUnits += 1;

      while (coveredUnits === targetUnitCount && left <= right) {
        const candidate = events.slice(left, right + 1);
        if (
          !best ||
          candidate.length < best.length ||
          (candidate.length === best.length &&
            candidate[0].unitSequence < best[0].unitSequence)
        ) best = candidate;

        const removedFsn = fsnKey(events[left].item.fsn);
        const countBeforeRemoval = counts.get(removedFsn) || 0;
        counts.set(removedFsn, countBeforeRemoval - 1);
        if (countBeforeRemoval <= (quotaByFsn.get(removedFsn) || 0)) coveredUnits -= 1;
        left += 1;
      }
    });
    return best || [];
  }

  function tlSequenceCoverageEvidence(destinationBoxIds, shortUnitsByFsn, tlIds, tlById) {
    const destinationSet = new Set(Array.from(destinationBoxIds || []).map(exactText).filter(Boolean));
    const shortUnitQuotas = normaliseShortUnitQuotas(shortUnitsByFsn);
    const evidenceByFsn = new Map();
    const detailsByFsn = new Map();
    const evaluations = [];
    const addEvidence = (fsn, evidence) => {
      const key = fsnKey(fsn);
      if (!evidenceByFsn.has(key)) evidenceByFsn.set(key, []);
      evidenceByFsn.get(key).push(evidence);
    };
    const addDetail = (fsn, detail) => {
      const key = fsnKey(fsn);
      if (!detailsByFsn.has(key)) detailsByFsn.set(key, []);
      detailsByFsn.get(key).push(detail);
    };

    unique(tlIds || []).forEach(tlId => {
      const tl = tlById.get(tlId);
      if (!tl) return;
      const lostEvents = (tl.items || [])
        .filter(item => {
          const destination = exactText(item.destinationBox || item.destinationLocationId);
          return (
            destinationSet.has(destination) &&
            shortUnitQuotas.has(fsnKey(item.fsn)) &&
            sequenceNumber(item.tlUnitSequence) !== null
          );
        })
        .map(item => ({
          item,
          destination: exactText(item.destinationBox || item.destinationLocationId),
          unitSequence: sequenceNumber(item.tlUnitSequence)
        }))
        .sort((left, right) =>
          left.destination.localeCompare(right.destination) ||
          left.unitSequence - right.unitSequence ||
          (left.item.responseIndex || 0) - (right.item.responseIndex || 0)
        );

      const eventsByDestination = new Map();
      lostEvents.forEach(event => {
        if (!eventsByDestination.has(event.destination)) {
          eventsByDestination.set(event.destination, []);
        }
        eventsByDestination.get(event.destination).push(event);
      });

      eventsByDestination.forEach((destinationEvents, destination) => {
        const matchedRowsByFsn = new Map();
        destinationEvents.forEach(event => {
          const fsn = fsnKey(event.item.fsn);
          if (!matchedRowsByFsn.has(fsn)) matchedRowsByFsn.set(fsn, []);
          matchedRowsByFsn.get(fsn).push(event);
        });

        const matchedQuotaByFsn = new Map();
        matchedRowsByFsn.forEach((events, fsn) => {
          matchedQuotaByFsn.set(
            fsn,
            Math.min(shortUnitQuotas.get(fsn) || 0, events.length)
          );
        });
        const matchedShortUnitCount = Array.from(matchedQuotaByFsn.values())
          .reduce((sum, quantity) => sum + quantity, 0);
        const blocks = [];
        destinationEvents.forEach(event => {
          const previous = blocks[blocks.length - 1];
          if (!previous || event.unitSequence !== previous.endSequence + 1) {
            blocks.push({ events: [event], endSequence: event.unitSequence });
            return;
          }
          previous.events.push(event);
          previous.endSequence = event.unitSequence;
        });

        const scoredBlocks = blocks.map(block => {
          const occurrencesByFsn = new Map();
          block.events.forEach(event => {
            const fsn = fsnKey(event.item.fsn);
            occurrencesByFsn.set(fsn, (occurrencesByFsn.get(fsn) || 0) + 1);
          });
          const shortUnitCount = Array.from(occurrencesByFsn.entries()).reduce(
            (sum, [fsn, count]) => sum + Math.min(matchedQuotaByFsn.get(fsn) || 0, count),
            0
          );
          const events = shortestQuotaWindow(block.events, matchedQuotaByFsn, shortUnitCount);
          return {
            events,
            shortUnitCount,
            startSequence: events[0]?.unitSequence ?? null,
            endSequence: events[events.length - 1]?.unitSequence ?? null
          };
        });
        scoredBlocks.sort((left, right) =>
          right.shortUnitCount - left.shortUnitCount ||
          left.events.length - right.events.length ||
          (left.startSequence ?? Infinity) - (right.startSequence ?? Infinity)
        );
        const bestBlock = scoredBlocks[0] || null;
        const blockShortUnitCount = bestBlock?.shortUnitCount || 0;
        const coverage = matchedShortUnitCount
          ? blockShortUnitCount / matchedShortUnitCount
          : 0;
        const qualifies = Boolean(
          bestBlock &&
          bestBlock.events.length >= 2 &&
          blockShortUnitCount >= 2 &&
          coverage >= TL_SEQUENCE_COVERAGE_THRESHOLD
        );
        const blockOccurrencesByFsn = new Map();
        (bestBlock?.events || []).forEach(event => {
          const fsn = fsnKey(event.item.fsn);
          if (!blockOccurrencesByFsn.has(fsn)) blockOccurrencesByFsn.set(fsn, []);
          blockOccurrencesByFsn.get(fsn).push(event.unitSequence);
        });
        const detail = {
          tlId,
          destination,
          matchedShortUnitCount,
          blockShortUnitCount,
          coverage,
          startSequence: bestBlock?.startSequence ?? null,
          endSequence: bestBlock?.endSequence ?? null,
          qualifies
        };
        evaluations.push(detail);
        matchedRowsByFsn.forEach((rows, fsn) => {
          const positions = blockOccurrencesByFsn.get(fsn) || [];
          const fsnDetail = {
            ...detail,
            fsn,
            matchedShortUnitsForFsn: matchedQuotaByFsn.get(fsn) || 0,
            blockShortUnitsForFsn: Math.min(
              matchedQuotaByFsn.get(fsn) || 0,
              positions.length
            ),
            blockUnitPositionsForFsn: positions.slice(
              0,
              matchedQuotaByFsn.get(fsn) || 0
            ),
            partialUnitInference:
              rows.length > (matchedQuotaByFsn.get(fsn) || 0),
            inQualifyingBlock: qualifies && positions.length > 0
          };
          addDetail(fsn, fsnDetail);
        });
        if (!qualifies) return;

        const evidence =
          'TL ' + tlId + ' box ' + destination + ' unit sequence ' +
          bestBlock.startSequence + '→' + bestBlock.endSequence + ': ' +
          blockShortUnitCount + '/' + matchedShortUnitCount +
          ' matched-lost units (' + formatPercent(coverage) +
          ') in one continuous block; unit positions inferred from ordered picklistItems.';
        blockOccurrencesByFsn.forEach((positions, fsn) => {
          if (Math.min(matchedQuotaByFsn.get(fsn) || 0, positions.length) > 0) {
            addEvidence(fsn, evidence);
          }
        });
      });
    });

    evidenceByFsn.forEach((values, fsn) => evidenceByFsn.set(fsn, unique(values)));
    return { evidenceByFsn, detailsByFsn, evaluations };
  }

  function baseLabel(kind, cold, flow) {
    if (kind === 'same-fsn-addexcess') return LABELS.sameFsnAddexcess;
    if (cold && kind === 'mismatch') return LABELS.coldMismatch;
    if (cold && kind === 'misshipment') return LABELS.coldMisshipment;
    if (cold && kind === 'short') return LABELS.coldShort;
    if (flow === 'PBD' && kind === 'mismatch') return LABELS.pbdMismatch;
    if (flow === 'PBD' && kind === 'misshipment') return LABELS.pbdMisshipment;
    if (flow === 'PBD' && kind === 'short') return LABELS.pbdShort;
    if (flow === 'P&S' && kind === 'mismatch') return LABELS.psMismatch;
    if (flow === 'P&S' && kind === 'misshipment') return LABELS.psMisshipment;
    if (flow === 'P&S' && kind === 'short') return LABELS.psShort;
    return '';
  }

  function resolveClassification(decision, caseSizeByFsn, bulkFsns) {
    if (decision.packslipConfirmed) {
      return {
        kind: 'packing-slip-mismatch',
        label: LABELS.packingSlipMismatch,
        rule:
          'Box-level Packing Slip Mismatch: all expected FSNs are completely short, ' +
          'none were received, and expected/excess FSNs do not overlap.',
        error: ''
      };
    }
    const key = fsnKey(decision.row.fsn);
    const caseSize = caseSizeByFsn.get(key);
    const isBulk = bulkFsns.has(key);
    if (decision.sameFsnExact) {
      return {
        kind: 'same-fsn-addexcess',
        label: LABELS.sameFsnAddexcess,
        rule:
          'Same FSN short and Addexcess quantities match exactly at ' +
          decision.sameFsnAddexcessQuantity + '.',
        error: ''
      };
    }
    if (decision.quantityConflict) {
      return {
        kind: 'review',
        label: '',
        rule: decision.quantityConflict,
        error: decision.quantityConflict
      };
    }
    if (caseSize && isBulk) {
      return {
        kind: 'review',
        label: '',
        rule: '',
        error: 'FSN appears in both Case and Bulk masters.'
      };
    }

    const shortQuantity = decision.boxFsnShortQuantity || decision.allocatedShort;
    if (caseSize) {
      const remainder = shortQuantity % caseSize;
      let caseRule =
        'Case FSN aggregate short=' + shortQuantity +
        ', case size=' + caseSize + ', remainder=' + remainder + '.';
      if (decision.parallelSameFsnEvidence) {
        caseRule +=
          ' Partial same-FSN Addexcess=' + decision.sameFsnAddexcessQuantity +
          ' is parallel evidence and does not replace the complete-carton test.';
      }
      if (remainder !== 0) {
        return {
          kind: 'short',
          label: LABELS.caseNonMultipleShort,
          rule: caseRule + ' Inside-carton loss.',
          error: ''
        };
      }
      if (decision.mismatchQuantity > 0) {
        return {
          kind: 'mismatch',
          label: LABELS.caseMismatch,
          rule: caseRule + ' Complete same-vertical Case Addexcess allocated.',
          error: ''
        };
      }
      if (decision.misshipmentQuantity > 0) {
        return {
          kind: 'misshipment',
          label: LABELS.caseMisshipment,
          rule: caseRule + ' Complete different-vertical Case Addexcess allocated.',
          error: ''
        };
      }
      return { kind: 'short', label: LABELS.caseMultipleShort, rule: caseRule, error: '' };
    }

    if (isBulk) {
      if (decision.mismatchQuantity > 0) {
        return {
          kind: 'mismatch',
          label: LABELS.bulkMismatch,
          rule: 'Bulk FSN has different-FSN same-vertical Addexcess.',
          error: ''
        };
      }
      if (decision.misshipmentQuantity > 0) {
        return {
          kind: 'misshipment',
          label: LABELS.bulkMisshipment,
          rule: 'Bulk FSN has different-vertical Addexcess.',
          error: ''
        };
      }
      return {
        kind: 'short',
        label: LABELS.bulkShort,
        rule: 'Bulk FSN short with no allocated foreign Addexcess.',
        error: ''
      };
    }

    return {
      kind: decision.kind,
      label: baseLabel(decision.kind, decision.cold, decision.flow),
      rule: '',
      error: ''
    };
  }

  function isTlSequenceBaseEligible(decision) {
    return (
      decision.kind === 'short' &&
      ['PBD', 'P&S'].includes(decision.flow) &&
      !decision.cold &&
      !decision.isCaseFsn &&
      !decision.isBulkFsn &&
      !decision.sameFsnExact &&
      !decision.mismatchQuantity &&
      !decision.misshipmentQuantity
    );
  }

  function passesTlSequenceMissingRateGate(decision) {
    return (
      Number.isFinite(decision.boxMissingRate) &&
      decision.boxMissingRate > TL_SEQUENCE_BOX_MISSING_THRESHOLD
    );
  }

  function passesTlSequenceBoxUnitGate(decision) {
    return (
      Number.isFinite(decision.boxExpectedUnitCount) &&
      decision.boxExpectedUnitCount > TL_SEQUENCE_BOX_UNIT_THRESHOLD
    );
  }

  function isTlSequenceEligible(decision) {
    return (
      isTlSequenceBaseEligible(decision) &&
      passesTlSequenceMissingRateGate(decision) &&
      passesTlSequenceBoxUnitGate(decision)
    );
  }

  function requiresOutboundEvidence(decision) {
    if (
      decision.kind === 'review' ||
      decision.packslipConfirmed ||
      decision.sameFsnExact ||
      decision.isCaseFsn ||
      decision.isBulkFsn
    ) return false;
    if (!decision.cold) return true;
    return ['short', 'misshipment'].includes(decision.kind);
  }

  function buildTlSequenceScopes(decisions, deepBoxData, allocationContexts = new Map()) {
    const scopes = new Map();
    decisions.filter(isTlSequenceBaseEligible).forEach(decision => {
      const contextKey = iwitKey(decision.row);
      if (!scopes.has(contextKey)) {
        const authoritativeShortUnits = allocationContexts.get(contextKey)?.boxShortUnitsByFsn;
        scopes.set(contextKey, {
          shortUnitsByFsn: authoritativeShortUnits
            ? new Map(authoritativeShortUnits)
            : new Map(),
          hasAuthoritativeShortUnits: Boolean(authoritativeShortUnits),
          destinationBoxes: new Set([decision.row.boxId])
        });
      }
      if (decision.flow === 'P&S') {
        const mappedInputs = deepBoxData.get(decision.row.boxId)?.mapping?.inputBoxes || [];
        mappedInputs.forEach(boxId => scopes.get(contextKey).destinationBoxes.add(boxId));
      }
    });
    decisions.forEach(decision => {
      const scope = scopes.get(iwitKey(decision.row));
      if (scope && !scope.hasAuthoritativeShortUnits && decision.allocatedShort > 0) {
        const fsn = fsnKey(decision.row.fsn);
        scope.shortUnitsByFsn.set(
          fsn,
          (scope.shortUnitsByFsn.get(fsn) || 0) + decision.allocatedShort
        );
      }
    });
    return scopes;
  }

  function applyOrphanToteRules(decision, physical) {
    if (decision.isCaseFsn) {
      const reasons = decision.aeValue === LABELS.caseMultipleShort ? ['Case multiple'] : [];
      return { label: decision.aeValue, reasons, rule: '' };
    }
    if (decision.isBulkFsn || !['short', 'misshipment'].includes(decision.kind)) {
      return { label: decision.aeValue, reasons: [], rule: '' };
    }

    const weightWise = Boolean(physical?.weightLimitExceeded);
    const confirmedReasons = [];
    if (decision.kind === 'short' && decision.tlSequenceWise) {
      confirmedReasons.push('TL Sequence wise');
    }
    const reasons = [...confirmedReasons];
    if (weightWise) reasons.push('Weight Wise');
    let label = decision.aeValue;
    if (confirmedReasons.length) {
      label = reasons.length === 1
        ? LABELS.tlSequenceOrphan
        : LABELS.tlSequenceOrphan + ' + ' + reasons.slice(1).join(' + ');
    } else if (weightWise && decision.aeValue) {
      label = decision.aeValue + ' - ' + LABELS.orphanTote + ' - Weight Wise';
    }
    return {
      label,
      reasons,
      rule: reasons.length ? 'Orphan Tote reason: ' + reasons.join(' + ') + '.' : ''
    };
  }

  function formatPercent(value) {
    return Number.isFinite(value) ? (value * 100).toFixed(1) + '%' : '';
  }

  function buildOperationalAnalysis(decision, deep) {
    const evidence = [];
    const hypotheses = [];
    const warnings = [...(deep.warnings || [])];
    let deepSignals = 0;
    let orphanSignals = 0;
    if (decision.allocationWarning) warnings.push(decision.allocationWarning);

    if (decision.packslipConfirmed) {
      hypotheses.push(LABELS.packingSlipMismatch);
      evidence.push(
        'No expected FSN was received, every expected FSN is completely short, and the box contains only non-overlapping excess FSNs.'
      );
      deepSignals += 2;
    }

    if (isTlSequenceBaseEligible(decision)) {
      if (Number.isFinite(decision.boxMissingRate)) {
        evidence.push(
          'Box marked-short units=' + decision.boxShortUnitCount +
          '/' + decision.boxExpectedUnitCount +
          ' (' + formatPercent(decision.boxMissingRate) +
          '); TL Orphan Tote missing gate >30%=' + decision.tlSequenceMissingRateGate +
          '; box-unit gate >40=' + decision.tlSequenceBoxUnitGate + '.'
        );
      } else {
        warnings.push(
          'Complete-box expected/short totals were unavailable; TL sequence Orphan Tote gate failed closed.'
        );
      }
    }

    if (decision.kind === 'same-fsn-addexcess') {
      hypotheses.push('Same FSN Addexcess');
      evidence.push(
        'Same FSN short=' + decision.boxFsnShortQuantity +
          ' and Addexcess=' + decision.sameFsnAddexcessQuantity + '.'
      );
      deepSignals += 2;
    } else if (decision.kind === 'mismatch') {
      const candidates = decision.mismatchCandidates
        .map(candidate => candidate.fsn + ' x' + candidate.quantity)
        .join(', ');
      evidence.push('Same-vertical excess allocated: ' + (candidates || decision.mismatchQuantity));
      if (decision.misshipmentQuantity > 0) {
        evidence.push(
          'Different-vertical Misshipment evidence also allocated: ' +
            decision.misshipmentCandidates
              .map(candidate => candidate.fsn + ' x' + candidate.quantity)
              .join(', ') + '.'
        );
      }
      if (decision.flow === 'P&S') {
        if (deep.mappingTargetPresent) {
          hypotheses.push('P&S input-to-output transfer mismatch suspected');
          evidence.push('Target FSN is linked to the P&S input/output mapping.');
          deepSignals += 1;
        } else if (deep.path.targetEventCount) {
          hypotheses.push('P&S input-to-output handling mismatch suspected');
        } else {
          hypotheses.push('P&S upstream picking mismatch suspected');
        }
      } else if (decision.flow === 'PBD') {
        hypotheses.push('PBD wrong-item/wrong-tote mismatch');
      } else {
        hypotheses.push('Mismatch');
      }
    } else if (decision.kind === 'misshipment') {
      const candidates = decision.misshipmentCandidates
        .map(candidate => candidate.fsn + ' x' + candidate.quantity)
        .join(', ');
      hypotheses.push(
        decision.flow === 'P&S'
          ? 'P&S cross-vertical Misshipment suspected'
          : decision.flow === 'PBD'
            ? 'PBD cross-vertical Misshipment suspected'
            : 'Cross-vertical Misshipment suspected'
      );
      evidence.push(
        'Different-vertical excess allocated: ' + (candidates || decision.misshipmentQuantity) + '.'
      );
      if (decision.unexplainedShortQuantity > 0) {
        evidence.push(
          'Misshipment does not explain ' + decision.unexplainedShortQuantity +
            ' remaining short unit(s); AE wording intentionally has no Partial label.'
        );
      }
      deepSignals += 2;
    } else if (decision.kind === 'short') {
      const evidenceQuantity = Math.max(decision.row.quantity, decision.sheetBoxFsnQuantity || 0);
      if (decision.flow === 'P&S') {
        if (deep.mappingTargetPresent) {
          hypotheses.push('P&S input-to-output transfer short suspected');
          evidence.push('Target FSN is present in the input/output mapping but short in the output box.');
          deepSignals += 1;
        } else if (deep.path.targetEventCount) {
          hypotheses.push('P&S input/sortation transfer issue suspected');
        } else {
          hypotheses.push('P&S bulk-picking short suspected');
        }
        evidence.push(
          evidenceQuantity === 1
            ? 'Single quantity alone does not determine whether the loss occurred in picking or sortation.'
            : 'Multiple quantity allows both upstream short-picking and input-to-output transfer explanations.'
        );
      } else if (decision.flow === 'PBD') {
        hypotheses.push(
          evidenceQuantity === 1
            ? 'PBD cross-box putting suspected'
            : 'PBD short picking/manual-quantity risk'
        );
        evidence.push(
          evidenceQuantity === 1
            ? 'A single expected unit is completely short from its assigned box.'
            : 'Multiple units were short under one Box ID.'
        );
      } else {
        hypotheses.push('Short');
      }
    }

    if (decision.specialRule) evidence.push(decision.specialRule);
    if (decision.unallocatedExcess?.length) {
      evidence.push(
        'Unallocated excess remaining in box: ' +
          decision.unallocatedExcess
            .map(candidate => candidate.fsn + ' x' + candidate.quantity)
            .join(', ') + '.'
      );
    }
    if (deep.inputBoxes.length) {
      evidence.push('P&S input box(es): ' + deep.inputBoxes.join(', ') + '.');
      deepSignals += 1;
    }
    if (deep.path.targetEventCount) {
      evidence.push(
        'Target FSN appears ' + deep.path.targetEventCount + ' time(s) in TL path; destination box match=' + deep.path.targetInExactBox + '.'
      );
      deepSignals += 1;
    }
    const neighbourPreview = deep.path.neighbourPreview;
    if (neighbourPreview?.status === 'resolved') {
      [neighbourPreview.previous, neighbourPreview.next]
        .filter(neighbour => neighbour?.found)
        .forEach(neighbour => {
          evidence.push(
            'TL ' + neighbour.direction + ' visual neighbour: FSN=' +
            (neighbour.fsn || '?') + ', title=' +
            (neighbour.productTitle || '?') + ', unit sequence=' +
            (neighbour.tlUnitSequence ?? '?') + ', source=' +
            (neighbour.sourceLocation || '?') + ', box=' +
            (neighbour.destinationBox || '?') + '.'
          );
        });
    } else if (neighbourPreview?.status === 'ambiguous') {
      evidence.push('TL visual neighbours unavailable: ' + neighbourPreview.note);
    }
    if (deep.path.minimumCandidatePickDistance !== null) {
      evidence.push('Nearest mismatch-candidate TL unit-sequence distance=' + deep.path.minimumCandidatePickDistance + '.');
      if (deep.path.minimumCandidatePickDistance <= 1) deepSignals += 1;
    }
    if (deep.path.sameSourceLocationCandidate) {
      evidence.push('Target and excess-candidate FSNs share a source location.');
      deepSignals += 1;
    }
    if (deep.path.adjacentLocationSequenceCandidate) {
      evidence.push('Target and excess-candidate FSNs are at the same/adjacent location sequence.');
      deepSignals += 1;
    }
    if (deep.path.bulkQuantityEvent) {
      evidence.push('TL contains quantity >1 or bulk-picking evidence for the target FSN.');
      deepSignals += 1;
    }
    if (deep.path.tlSequenceWise) {
      evidence.push(...deep.path.tlSequenceEvidence);
      if (deep.path.tlSequencePartialUnitInference) {
        warnings.push(
          'Partial short: exact missing unit identity is unavailable; qualifying unit positions were inferred from ordered TL rows and the short-unit quota.'
        );
      }
      deepSignals += 1;
    }
    if (deep.inputBoxes.length > 1) {
      evidence.push(
        'Mapping links the output to multiple input boxes; this can be normal P&S consolidation and is not an orphan-tote signal by itself.'
      );
    }
    if (deep.path.targetEventCount && !deep.path.targetInExactBox && deep.path.destinationBoxes.length) {
      evidence.push(
        'TL target event does not resolve to the final output label; P&S TL destinations may represent input-stage containers, so this is not treated as cross-box proof.'
      );
    }
    if (deep.path.containerEvidence.some(value => /dropped=false/i.test(value))) {
      evidence.push('Container status includes isDropped=false; treated only as supporting close/drop evidence.');
    }
    if (
      deep.physicalSource &&
      (
        deep.physical.totalVolume !== null ||
        deep.physical.totalWeight !== null ||
        deep.physical.effectiveTotalWeight !== null
      )
    ) {
      evidence.push('Physical attributes source: ' + deep.physicalSource + '.');
    }
    if (deep.physical.totalVolume !== null) {
      evidence.push(
        'Mapped volume=' + deep.physical.totalVolume + ' ' + PHYSICAL_LIMITS.mappingVolumeUnit +
          ' with attribute coverage ' + formatPercent(deep.physical.volumeCoverage) +
          ' and tote utilization ' + formatPercent(deep.physical.volumeUtilization) + '.'
      );
      if (deep.physical.volumeLimitExceeded) {
        evidence.push(
          'Known mapped volume exceeds the ' + PHYSICAL_LIMITS.toteVolumeCm3 + ' ' +
            PHYSICAL_LIMITS.mappingVolumeUnit +
            ' tote capacity; advisory only because source volume can be imperfect.'
        );
        deepSignals += 1;
      }
    }
    if (deep.physical.totalWeight !== null) {
      evidence.push(
        'Mapped weight=' + deep.physical.totalWeight + ' ' + PHYSICAL_LIMITS.mappingWeightUnit +
          ' with attribute coverage ' + formatPercent(deep.physical.weightCoverage) +
          ' and tote utilization ' + formatPercent(deep.physical.weightUtilization) + '.'
      );
    }
    if (deep.physical.titleDerivedTotalWeight !== null) {
      evidence.push(
        'Title-derived weight=' + deep.physical.titleDerivedTotalWeight + ' ' +
          PHYSICAL_LIMITS.mappingWeightUnit + ' with title coverage ' +
          formatPercent(deep.physical.titleWeightCoverage) + '.'
      );
    }
    if (deep.physical.effectiveTotalWeight !== null && deep.physical.titleWeightCoverage > 0) {
      evidence.push(
        'Effective tote weight=' + deep.physical.effectiveTotalWeight + ' ' +
          PHYSICAL_LIMITS.mappingWeightUnit + ' using ' +
          deep.physical.effectiveWeightSource + '.'
      );
    }
    if (deep.physical.weightLimitExceeded) {
      evidence.push(
        decision.isCaseFsn || decision.isBulkFsn
          ? 'Effective weight meets or exceeds ' + PHYSICAL_LIMITS.toteWeightKg +
              ' kg, but the weight rule is excluded for Case/Bulk master FSNs.'
          : 'Effective weight meets or exceeds ' + PHYSICAL_LIMITS.toteWeightKg +
              ' kg; treated as a supporting Weight Wise Orphan Tote signal, with the original classification retained unless another confirmed orphan reason exists.'
      );
      deepSignals += 1;
    }
    const orphanReasons = decision.orphanReasons || [];
    if (orphanReasons.length) {
      hypotheses.push('Orphan tote suspected');
      evidence.push(LABELS.orphanTote + ' - ' + orphanReasons.join(' + '));
      orphanSignals = orphanReasons.length;
      deepSignals += 1;
    }

    let confidence = 'LOW';
    if (!decision.aeValue) confidence = 'REVIEW';
    else if (
      decision.cold ||
      decision.specialRule ||
      ['mismatch', 'misshipment', 'same-fsn-addexcess'].includes(decision.kind) ||
      deepSignals >= 2
    ) confidence = 'HIGH';
    else if (deepSignals >= 1) confidence = 'MEDIUM';
    if (decision.flow === 'P&S' && warnings.length && confidence === 'HIGH') {
      confidence = 'MEDIUM';
      evidence.push('P&S operational confidence is capped at MEDIUM because one or more deep-evidence requests failed.');
    }

    return {
      hypothesis: unique(hypotheses).join('; '),
      confidence,
      evidence: unique(evidence),
      warnings: unique(warnings),
      orphanSignals,
      deepSignals
    };
  }

