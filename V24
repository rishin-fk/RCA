  function sleep(milliseconds) {
    return new Promise(resolve => setTimeout(resolve, milliseconds));
  }

  function parseBody(text) {
    if (!text) return null;
    try {
      return JSON.parse(text);
    } catch {
      return text;
    }
  }

  function responseMessage(body) {
    if (typeof body === 'string') return body.slice(0, 300);
    return exactText(
      directField(body, ['message', 'error', 'error_code', 'errorCode', 'detail']) || 'Unknown error'
    );
  }

  function responseErrorCode(result) {
    if (!result || typeof result.body !== 'object' || result.body === null) return '';
    return exactText(directField(result.body, ['error_code', 'errorCode', 'code'])).toUpperCase();
  }

  function isConsignmentNotFound(result) {
    return (
      responseErrorCode(result) === 'CONSIGNMENT_NOT_FOUND' ||
      /\bconsignment\s+not\s+found\b/i.test(exactText(result?.error))
    );
  }

  function warehouseNamedInResult(result) {
    const message = exactText(result?.error) || responseMessage(result?.body);
    const match = message.match(/\bwarehouse\s*:\s*([a-z0-9_-]+)/i);
    return match ? match[1] : '';
  }

  function wrongWarehouse(result, intendedFacility) {
    const observedFacility = warehouseNamedInResult(result);
    if (!observedFacility) return null;
    if (observedFacility.toLowerCase() === exactText(intendedFacility).toLowerCase()) return null;
    return {
      intendedFacility: exactText(intendedFacility),
      observedFacility
    };
  }

  function supersedeFailedFetch(stats, result) {
    if (result && !result.ok && !result.contextFailure) {
      stats.failures = Math.max(0, stats.failures - 1);
    }
  }

  function makeIdempotenceKey(boxId) {
    const randomPart = globalThis.crypto?.randomUUID
      ? globalThis.crypto.randomUUID()
      : Math.random().toString(36).slice(2);
    return 'rca-' + Date.now() + '-' + boxId + '-' + randomPart;
  }

  function sameOriginPath(path) {
    const resolved = new URL(path, location.origin);
    if (resolved.origin !== location.origin) throw new Error('Blocked non-Flo-lite request: ' + resolved.origin);
    return resolved.pathname + resolved.search;
  }

  function newRunStats() {
    return {
      networkRequests: 0,
      cacheHits: 0,
      failures: 0,
      retries: 0,
      contextSwitches: 0,
      contextRetries: 0,
      contextMismatches: 0,
      contextFailures: 0,
      contexts: [],
      failureLedger: [],
      failureBreakdown: [],
      reconciledFailureCount: 0
    };
  }

  async function fetchJson(options) {
    const {
      path,
      method: requestedMethod = 'GET',
      headers = {},
      cache,
      cacheKey,
      stats,
      maxRetries: requestedMaxRetries = DEFAULTS.retries,
      requestContext = null,
      requestType = '',
      boxId = '',
      documentId = '',
      tlId = ''
    } = options;
    const method = exactText(requestedMethod).toUpperCase();
    const maxRetries = Math.max(0, Math.floor(finiteNumber(requestedMaxRetries, DEFAULTS.retries)));
    const sorterPost = method === 'POST' && options.requestType === 'Sorter attribution' &&
      /^\/flo-lite-routes-api\/outbound-picking-proxy\/api\/v3\.0\/containers\/details\/label\/[^/?#]+$/.test(path) &&
      options.body && Object.keys(options.body).length === 1 && looksLikeTlId(options.body.externalPicklistId);
    if (method !== 'GET' && !sorterPost) throw new Error('Blocked non-GET request method: ' + method);
    const safePath = sameOriginPath(path);
    const requestInfo = {
      requestType: exactText(requestType),
      method,
      path: safePath,
      boxId: exactText(boxId),
      documentId: exactText(documentId),
      tlId: exactText(tlId),
      contextType: exactText(requestContext?.contextType),
      contextBoxId: exactText(requestContext?.boxId),
      referrerPath: (() => {
        try {
          return new URL(requestContext?.referrer || location.href, location.origin).pathname;
        } catch {
          return '';
        }
      })()
    };
    if (cache.has(cacheKey)) {
      stats.cacheHits += 1;
      return { ...cache.get(cacheKey), fromCache: true };
    }

    let lastResult = null;
    for (let attempt = 0; attempt <= maxRetries; attempt += 1) {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), DEFAULTS.timeoutMs);
      try {
        stats.networkRequests += 1;
        const fetchFn = requestContext?.fetchFn || window.fetch.bind(window);
        const response = await fetchFn(safePath, {
          method,
          credentials: 'include',
          cache: 'no-store',
          headers: { Accept: 'application/json', ...headers },
          ...(sorterPost ? {body: JSON.stringify(options.body)} : {}),
          signal: controller.signal,
          referrer: requestContext?.referrer || location.href,
          referrerPolicy: 'strict-origin-when-cross-origin'
        });
        const parsedBody = parseBody(await response.text());
        lastResult = {
          ok: response.ok,
          status: response.status,
          body: parsedBody,
          error: response.ok ? '' : responseMessage(parsedBody),
          fromCache: false,
          requestInfo
        };
        if (response.ok) {
          cache.set(cacheKey, lastResult);
          return lastResult;
        }
        const retryable = [408, 425, 429].includes(response.status) || response.status >= 500;
        if (!retryable || attempt === maxRetries) break;
      } catch (error) {
        lastResult = {
          ok: false,
          status: 0,
          body: null,
          error:
            error?.name === 'AbortError'
              ? 'Timed out after ' + DEFAULTS.timeoutMs / 1000 + ' seconds'
              : error?.message || String(error),
          fromCache: false,
          requestInfo
        };
        if (attempt === maxRetries) break;
      } finally {
        clearTimeout(timeout);
      }
      stats.retries += 1;
      const jitter = Math.floor(Math.random() * 250);
      await sleep(650 * Math.pow(2, attempt) + jitter);
    }
    stats.failures += 1;
    return lastResult || {
      ok: false,
      status: 0,
      body: null,
      error: 'Unknown fetch failure',
      fromCache: false,
      requestInfo
    };
  }

