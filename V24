    ['Warnings', row => row.analysis.warnings],
    ['AE output', row => row.aeValue],
    ['Final status', row => row.finalStatus]
  ];

  function buildAuditTsv(finalRows) {
    const lines = [AUDIT_COLUMNS.map(column => column[0]).join('\t')];
    finalRows.forEach(row => {
      lines.push(AUDIT_COLUMNS.map(column => tsvSafe(column[1](row))).join('\t'));
    });
    return lines.join('\n');
  }

  function buildAeQuantityImagesTsv(finalRows) {
    return finalRows
      .map(row =>
        [
          row.aeValue,
          row.outputExpectedQuantity,
          row.outputReceivedQuantity,
          sheetsImageFormula(row.expectedImageUrl),
          sheetsImageFormula(row.excessImageUrl),
          sheetsImageFormula(row.tlNeighbourPreview?.previous?.url),
          sheetsImageFormula(row.tlNeighbourPreview?.next?.url),
          row.attribution?.dispatchedBy || '',
          row.attribution?.sortedBy || [],
          row.attribution?.pickedBy || []
        ].map(tsvSafe).join('\t')
      )
      .join('\n');
  }

  function serialisableRow(row) {
    return {
      input: row.row,
      attribution: row.attribution || null,
      quantityAnalysis: {
        scope: QUANTITY_SCOPE,
        vertical: row.vertical,
        expected: row.expected,
        received: row.received,
        outputExpectedQuantity: row.outputExpectedQuantity,
        outputReceivedQuantity: row.outputReceivedQuantity,
        allocatedShort: row.allocatedShort,
        sameFsnAddexcessQuantity: row.sameFsnAddexcessQuantity,
        sameFsnExact: row.sameFsnExact,
        parallelSameFsnEvidence: row.parallelSameFsnEvidence,
        quantityConflict: row.quantityConflict,
        mismatchQuantity: row.mismatchQuantity,
        misshipmentQuantity: row.misshipmentQuantity,
        unexplainedShortQuantity: row.unexplainedShortQuantity,
        boxFsnShortQuantity: row.boxFsnShortQuantity,
        boxExpectedUnitCount: row.boxExpectedUnitCount,
        boxShortUnitCount: row.boxShortUnitCount,
        boxMissingRate: row.boxMissingRate,
        tlSequenceMissingRateGate: row.tlSequenceMissingRateGate,
        tlSequenceBoxUnitGate: row.tlSequenceBoxUnitGate,
        sheetBoxFsnQuantity: row.sheetBoxFsnQuantity,
        distinctFsnCount: row.distinctFsnCount,
        mismatchCandidates: row.mismatchCandidates,
        misshipmentCandidates: row.misshipmentCandidates,
        unallocatedExcess: row.unallocatedExcess,
        excessConservation: row.excessConservation,
        allocationWarning: row.allocationWarning,
        packslipSuspected: row.packslipSuspected,
        packslipConfirmed: row.packslipConfirmed,
        packslipShortUnitCount: row.packslipShortUnitCount,
        packslipExcessUnitCount: row.packslipExcessUnitCount
      },
      productImages: {
        expected: {
          fsn: row.expectedImageFsn,
          url: row.expectedImageUrl,
          source: row.expectedImageSource
        },
        excess: {
          fsn: row.excessImageFsn,
          url: row.excessImageUrl,
          source: row.excessImageSource
        },
        previousTlItem: row.tlNeighbourPreview?.previous || emptyTlNeighbour('previous'),
        nextTlItem: row.tlNeighbourPreview?.next || emptyTlNeighbour('next'),
        tlNeighbourResolution: {
          status: row.tlNeighbourPreview?.status || '',
          matchScope: row.tlNeighbourPreview?.matchScope || '',
          note: row.tlNeighbourPreview?.note || '',
          target: row.tlNeighbourPreview?.target || null
        }
      },
      cold: {
        known: row.coldKnown,
        value: row.cold,
        source: row.coldSource,
        temperature: row.temperature
      },
      outbound: {
        flow: row.flow,
        flowRaw: row.outboundFlowRaw,
        tlId: row.outboundTlId,
        consignment: row.outboundConsignment,
        evidenceWarning: row.outboundEvidenceWarning
      },
      deepEvidence: {
        inputBoxes: row.deep.inputBoxes,
        tlIds: row.deep.tlIds,
        mappingExternalPicklistId: row.deep.mappingExternalPicklistId || '',
        physical: row.deep.physical,
        physicalSource: row.deep.physicalSource,
        path: row.deep.path
      },
      masterClassification: {
        caseFsn: row.isCaseFsn,
        bulkFsn: row.isBulkFsn
      },
      specialRule: row.specialRule,
      orphanReasons: row.orphanReasons,
      hypothesis: row.analysis.hypothesis,
      confidence: row.analysis.confidence,
      evidence: row.analysis.evidence,
      warnings: row.analysis.warnings,
      aeValue: row.aeValue,
      finalStatus: row.finalStatus
    };
  }

  async function runBatch() {
    aeOutput.value = '';
    auditOutput.value = '';
    copyAeButton.disabled = true;
    copyAeQuantityImagesButton.disabled = true;
    copyAuditButton.disabled = true;
    downloadAuditButton.disabled = true;
    downloadJsonButton.disabled = true;
    lastRun = null;

    const settings = saveSettings(false);
    if (!settings) return;
    const parsedInput = parseRows(input.value);
    if (parsedInput.errors.length) {
      setStatus(parsedInput.errors.join('\n'), true);
      return;
    }
    const caseMaster = parseCaseMaster(storedState.caseMaster.raw, { allowEmpty: true });
    const bulkMaster = parseBulkMaster(storedState.bulkMaster.raw, { allowEmpty: true });
    const masterErrors = [...caseMaster.errors, ...bulkMaster.errors];
    if (masterErrors.length) {
      setStatus('Saved master validation failed:\n' + masterErrors.join('\n'), true);
      return;
    }
    if (!mastersReady(caseMaster, bulkMaster)) {
      setStatus(
        'Freeze-safe run blocked: save both the Case FSN and Bulk FSN masters before analysis. ' +
          'On another laptop, import the master backup or paste and save both masters first.',
        true
      );
      return;
    }

    const rows = parsedInput.rows;
    const stats = newRunStats();
    clearResponseCaches();
    runButton.disabled = true;
    runButton.textContent = 'Running…';

    try {
      const pastedQuantityByBoxFsn = new Map();
      rows.forEach(row => {
        const key = boxFsnKey(row);
        pastedQuantityByBoxFsn.set(key, (pastedQuantityByBoxFsn.get(key) || 0) + row.quantity);
      });
      const sheetVerticalByIwit = new Map();
      const sheetShortByIwit = new Map();
      rows.forEach(row => {
        const contextKey = iwitKey(row);
        if (!sheetVerticalByIwit.has(contextKey)) sheetVerticalByIwit.set(contextKey, new Map());
        if (!sheetShortByIwit.has(contextKey)) sheetShortByIwit.set(contextKey, new Map());
        const verticals = sheetVerticalByIwit.get(contextKey);
        const fsn = fsnKey(row.fsn);
        if (fsn && row.sheetVertical && !verticals.has(fsn)) {
          verticals.set(fsn, row.sheetVertical);
        }
        const shortQuantities = sheetShortByIwit.get(contextKey);
        if (fsn) {
          shortQuantities.set(fsn, (shortQuantities.get(fsn) || 0) + row.quantity);
        }
      });

      const uniqueIwitRows = [];
      const seenIwit = new Set();
      rows.forEach(row => {
        const key = iwitKey(row);
        if (!seenIwit.has(key)) {
          seenIwit.add(key);
          uniqueIwitRows.push(row);
        }
      });
      const iwitResults = new Map();
      let phaseCompleted = 0;
      const iwitRowsByFacility = new Map();
      uniqueIwitRows.forEach(row => {
        if (!iwitRowsByFacility.has(row.facility)) iwitRowsByFacility.set(row.facility, []);
        iwitRowsByFacility.get(row.facility).push(row);
      });
      for (const [facilityId, facilityRows] of iwitRowsByFacility.entries()) {
        setStatus(
          'Preparing IWIT/MWIT facility context ' + facilityId +
            ' (' + phaseCompleted + '/' + uniqueIwitRows.length + ' boxes complete)…'
        );
        let requestContext = null;
        try {
          requestContext = await prepareFacilityContext(facilityId, 'iwit', stats, {
            reason: 'initial-destination-group'
          });
        } catch (error) {
          const failure = facilityContextFailure(facilityId, 'iwit', error);
          facilityRows.forEach(row => iwitResults.set(iwitKey(row), failure));
          continue;
        }
        await mapWithLimit(facilityRows, DEFAULTS.concurrency, async row => {
          const result = await getIwit(row, settings, stats, requestContext);
          iwitResults.set(iwitKey(row), result);
          phaseCompleted += 1;
          setStatus(
            'IWIT/MWIT ' + facilityId + ': ' + phaseCompleted + '/' + uniqueIwitRows.length +
              ' boxes · context=' + requestContext.mode
          );
        });

        const allConsignmentsMissing =
          facilityRows.length > 0 &&
          facilityRows.every(row => isConsignmentNotFound(iwitResults.get(iwitKey(row))));
        if (allConsignmentsMissing) {
          stats.contextRetries += 1;
          setStatus(
            'All IWIT/MWIT lookups returned CONSIGNMENT_NOT_FOUND for ' + facilityId +
              '; recreating the isolated context once…'
          );
          try {
            requestContext = await prepareFacilityContext(facilityId, 'iwit', stats, {
              forceFresh: true,
              reason: 'all-consignments-not-found-guarded-retry'
            });
            await mapWithLimit(facilityRows, DEFAULTS.concurrency, async row => {
              const previous = iwitResults.get(iwitKey(row));
              supersedeFailedFetch(stats, previous);
              const retried = await getIwit(row, settings, stats, requestContext);
              if (isConsignmentNotFound(retried)) retried.contextRetryExhausted = true;
              iwitResults.set(iwitKey(row), retried);
            });
          } catch (error) {
            const failure = facilityContextFailure(facilityId, 'iwit', error);
            facilityRows.forEach(row => iwitResults.set(iwitKey(row), failure));
          }
        }
      }

      const allocationContexts = new Map();
      const decisions = [];
      rows.forEach(row => {
        const result = iwitResults.get(iwitKey(row));
        const decision = {
          row,
          kind: 'review',
          finalStatus: '',
          vertical: row.sheetVertical,
          temperature: '',
          expected: '',
          received: '',
          outputExpectedQuantity: '',
          outputReceivedQuantity: '',
          coldKnown: false,
          cold: false,
          coldSource: '',
          distinctFsnCount: 0,
          sheetBoxFsnQuantity: pastedQuantityByBoxFsn.get(boxFsnKey(row)) || 0,
          allocatedShort: 0,
          sameFsnAddexcessQuantity: 0,
          sameFsnExact: false,
          parallelSameFsnEvidence: false,
          quantityConflict: '',
          mismatchQuantity: 0,
          misshipmentQuantity: 0,
          unexplainedShortQuantity: 0,
          boxFsnShortQuantity: 0,
          boxExpectedUnitCount: null,
          boxShortUnitCount: null,
          boxMissingRate: null,
          mismatchCandidates: [],
          misshipmentCandidates: [],
          unallocatedExcess: [],
          excessConservation: null,
          packslipSuspected: false,
          packslipConfirmed: false,
          packslipShortUnitCount: 0,
          packslipExcessUnitCount: 0,
          expectedImageFsn: row.fsn,
          expectedImageUrl: '',
          expectedImageSource: '',
          excessImageFsn: '',
          excessImageUrl: '',
          excessImageSource: '',
          tlNeighbourPreview: {
            status: 'not-evaluated',
            matchScope: '',
            note: '',
            target: {
              tlId: '',
              blockStart: null,
              blockEnd: null,
              unitCount: 0,
              destinationBoxes: []
            },
            previous: emptyTlNeighbour('previous'),
            next: emptyTlNeighbour('next')
          },
          isCaseFsn: false,
          isBulkFsn: false,
          flow: '',
          outboundFlowRaw: '',
          outboundTlId: '',
          outboundConsignment: '',
          outboundEvidenceWarning: '',
          specialRule: '',
          aeValue: '',
          allocationWarning: ''
        };

        if (!result?.ok) {
          decision.finalStatus = apiFailure('IWIT/MWIT', result);
          decisions.push(decision);
          return;
        }
        const key = iwitKey(row);
        if (!allocationContexts.has(key)) {
          allocationContexts.set(
            key,
            buildAllocationContext(
              result.body,
              caseMaster.caseSizeByFsn,
              bulkMaster.bulkFsns,
              sheetVerticalByIwit.get(key) || new Map(),
              sheetShortByIwit.get(key) || new Map()
            )
          );
        }
        const context = allocationContexts.get(key);
        const targetFsn = fsnKey(row.fsn);
        const meta = context.metaByFsn.get(targetFsn);
        decision.boxExpectedUnitCount = context.boxExpectedUnitCount;
        decision.boxShortUnitCount = context.boxShortUnitCount;
        decision.boxMissingRate = context.boxMissingRate;
        decision.distinctFsnCount = context.distinctFsnCount;
        decision.packslipSuspected = context.packslipSuspected;
        decision.packslipConfirmed = context.packslipConfirmed;
        decision.packslipShortUnitCount = context.packslipShortUnitCount;
        decision.packslipExcessUnitCount = context.packslipExcessUnitCount;
        decision.isCaseFsn = caseMaster.caseSizeByFsn.has(targetFsn);
        decision.isBulkFsn = bulkMaster.bulkFsns.has(targetFsn);
        if (!meta) {
          if (decision.packslipConfirmed) {
            decision.kind = 'packing-slip-mismatch';
            decision.finalStatus = 'Classified';
          } else {
            decision.finalStatus = context.schemaWarning || 'FSN not found in IWIT/MWIT items_in_box.';
          }
          decisions.push(decision);
          return;
        }

        decision.vertical = meta.vertical || row.sheetVertical;
        decision.temperature = meta.temperature;
        decision.expected = meta.expected;
        decision.received = meta.received;
        decision.outputExpectedQuantity = meta.outputExpectedQuantity;
        decision.outputReceivedQuantity = meta.outputReceivedQuantity;
        const cold = classifyCold(row.location, meta.temperature);
        decision.coldKnown = cold.known;
        decision.cold = cold.cold;
        decision.coldSource = cold.source;

        if (decision.packslipConfirmed) {
          const reconciliation = context.reconciliationByFsn.get(targetFsn);
          if (reconciliation) {
            decision.sameFsnAddexcessQuantity = reconciliation.sameFsnUsed;
            decision.sameFsnExact = reconciliation.sameFsnExact;
            decision.parallelSameFsnEvidence = reconciliation.parallelSameFsnEvidence;
            decision.quantityConflict = reconciliation.quantityConflict;
            decision.mismatchQuantity = reconciliation.mismatchQuantity;
            decision.misshipmentQuantity = reconciliation.misshipmentQuantity;
            decision.unexplainedShortQuantity = reconciliation.unexplainedQuantity;
            decision.mismatchCandidates = reconciliation.mismatchCandidates;
            decision.misshipmentCandidates = reconciliation.misshipmentCandidates;
            decision.unallocatedExcess = context.unallocatedExcess || [];
            decision.excessConservation = context.excessConservation || null;
          }
          const availablePackslipShort = context.shortRemainingByFsn.get(targetFsn) || 0;
          decision.allocatedShort = Math.min(row.quantity, availablePackslipShort);
          context.shortRemainingByFsn.set(
            targetFsn,
            availablePackslipShort - decision.allocatedShort
          );
          decision.kind = 'packing-slip-mismatch';
          decision.finalStatus = 'Classified';
          decisions.push(decision);
          return;
        }

        const availableShort = context.shortRemainingByFsn.get(targetFsn) || 0;
        const allocatedShort = Math.min(row.quantity, availableShort);
        decision.allocatedShort = allocatedShort;
        context.shortRemainingByFsn.set(targetFsn, availableShort - allocatedShort);
        if (allocatedShort <= 0) {
          decision.finalStatus = 'FSN is not short according to IWIT/MWIT remaining allocation.';
          decisions.push(decision);
          return;
        }
        if (allocatedShort < row.quantity) {
          decision.finalStatus =
            'Sheet quantity ' + row.quantity + ' exceeds remaining IWIT/MWIT short ' + allocatedShort + '.';
          decisions.push(decision);
          return;
        }

        const reconciliation = context.reconciliationByFsn.get(targetFsn);
        if (!reconciliation) {
          decision.finalStatus = 'No reconciliation plan was available for the short FSN.';
          decisions.push(decision);
          return;
        }
        decision.sameFsnAddexcessQuantity = reconciliation.sameFsnUsed;
        decision.sameFsnExact = reconciliation.sameFsnExact;
        decision.parallelSameFsnEvidence = reconciliation.parallelSameFsnEvidence;
        decision.quantityConflict = reconciliation.quantityConflict;
        decision.mismatchQuantity = reconciliation.mismatchQuantity;
        decision.misshipmentQuantity = reconciliation.misshipmentQuantity;
        decision.unexplainedShortQuantity = reconciliation.unexplainedQuantity;
        decision.mismatchCandidates = reconciliation.mismatchCandidates;
        decision.misshipmentCandidates = reconciliation.misshipmentCandidates;
        decision.unallocatedExcess = context.unallocatedExcess || [];
        decision.excessConservation = context.excessConservation || null;
        decision.allocationWarning = decision.sameFsnExact ? '' : reconciliation.allocationWarning;

        if (decision.quantityConflict) {
          decision.finalStatus = decision.quantityConflict;
          decisions.push(decision);
          return;
        }
        if (decision.allocationWarning) {
          decision.finalStatus = decision.allocationWarning;
          decisions.push(decision);
          return;
        }
        if (!decision.coldKnown && !decision.sameFsnExact && !decision.isCaseFsn && !decision.isBulkFsn) {
          decision.finalStatus = 'Cold status unknown: Z is blank and IWIT/MWIT temperature is unavailable.';
          decisions.push(decision);
          return;
        }
        decision.kind = decision.sameFsnExact
          ? 'same-fsn-addexcess'
          : decision.mismatchQuantity > 0
            ? 'mismatch'
            : decision.misshipmentQuantity > 0
              ? 'misshipment'
              : 'short';
        decision.finalStatus = 'Classified';
        decisions.push(decision);
      });

      const shortByBoxFsn = new Map();
      decisions.forEach(decision => {
        const key = boxFsnKey(decision.row);
        shortByBoxFsn.set(
          key,
          (shortByBoxFsn.get(key) || 0) + decision.allocatedShort
        );
      });
      decisions.forEach(decision => {
        decision.boxFsnShortQuantity = decision.packslipConfirmed
          ? Math.max(finiteNumber(decision.expected, 0) - finiteNumber(decision.received, 0), 0)
          : shortByBoxFsn.get(boxFsnKey(decision.row)) || 0;
      });

      const outboundBoxes = unique(
        decisions
          .filter(requiresOutboundEvidence)
          .map(decision => decision.row.boxId)
      );
      const outboundResults = new Map();
      phaseCompleted = 0;
      let sourceRequestContext = null;
      let sourceContextFailure = null;
      if (outboundBoxes.length) {
        setStatus('Preparing sourcing-hub context ' + settings.sourceFacilityId + '…');
        try {
          sourceRequestContext = await prepareFacilityContext(
            settings.sourceFacilityId,
            'source',
            stats,
            { forceFresh: true, reason: 'initial-source-group' }
          );
        } catch (error) {
          sourceContextFailure = facilityContextFailure(
            settings.sourceFacilityId,
            'source',
            error
          );
        }
      }
      setStatus('Outbound flow/TL references: 0/' + outboundBoxes.length);
      if (sourceContextFailure) {
        outboundBoxes.forEach(boxId => outboundResults.set(boxId, sourceContextFailure));
      } else {
        await mapWithLimit(outboundBoxes, DEFAULTS.concurrency, async boxId => {
          const result = await getOutbound(boxId, settings, stats, sourceRequestContext);
          outboundResults.set(boxId, result);
          phaseCompleted += 1;
          setStatus('Outbound flow/TL references: ' + phaseCompleted + '/' + outboundBoxes.length);
        });

        const mismatchedBoxes = outboundBoxes.filter(boxId =>
          wrongWarehouse(outboundResults.get(boxId), settings.sourceFacilityId)
        );
        if (mismatchedBoxes.length) {
          stats.contextMismatches += mismatchedBoxes.length;
          stats.contextRetries += 1;
          setStatus(
            'Detected ' + mismatchedBoxes.length +
              ' outbound warehouse-context mismatch(es); recreating source context once…'
          );
          try {
            sourceRequestContext = await prepareFacilityContext(
              settings.sourceFacilityId,
              'source',
              stats,
              { forceFresh: true, reason: 'server-named-wrong-warehouse-retry' }
            );
            await mapWithLimit(mismatchedBoxes, DEFAULTS.concurrency, async boxId => {
              supersedeFailedFetch(stats, outboundResults.get(boxId));
              const retried = await getOutbound(boxId, settings, stats, sourceRequestContext);
              const repeatedMismatch = wrongWarehouse(retried, settings.sourceFacilityId);
              if (repeatedMismatch) retried.contextMismatch = repeatedMismatch;
              outboundResults.set(boxId, retried);
            });
          } catch (error) {
            const failure = facilityContextFailure(
              settings.sourceFacilityId,
              'source',
              error
            );
            mismatchedBoxes.forEach(boxId => outboundResults.set(boxId, failure));
          }
        }
      }

      decisions.forEach(decision => {
        if (decision.kind === 'review') return;
        if (!requiresOutboundEvidence(decision)) {
          const resolved = resolveClassification(
            decision,
            caseMaster.caseSizeByFsn,
            bulkMaster.bulkFsns
          );
          decision.kind = resolved.kind;
          decision.aeValue = resolved.label;
          decision.specialRule = resolved.rule;
          if (resolved.error) decision.finalStatus = resolved.error;
          return;
        }
        const result = outboundResults.get(decision.row.boxId);
        if (!result?.ok) {
          if (!decision.cold) {
            decision.finalStatus = apiFailure('Outbound', result);
            return;
          }
          decision.outboundEvidenceWarning = apiFailure('Outbound physical evidence', result);
          const resolved = resolveClassification(
            decision,
            caseMaster.caseSizeByFsn,
            bulkMaster.bulkFsns
          );
          decision.kind = resolved.kind;
          decision.aeValue = resolved.label;
          decision.specialRule = resolved.rule;
          decision.finalStatus = resolved.error || 'Classified';
          return;
        }
        const outbound = parseOutbound(result.body);
        decision.flow = outbound.flow;
        decision.outboundFlowRaw = outbound.flowRaw;
        decision.outboundTlId = outbound.tlId;
        decision.outboundConsignment = outbound.consignment;
        if (!outbound.flow && !decision.cold) {
          decision.finalStatus = outbound.schemaWarning;
          return;
        }
        if (!outbound.flow && decision.cold) {
          decision.outboundEvidenceWarning = outbound.schemaWarning;
        }
        const resolved = resolveClassification(
          decision,
          caseMaster.caseSizeByFsn,
          bulkMaster.bulkFsns
        );
        decision.kind = resolved.kind;
        decision.aeValue = resolved.label;
        decision.specialRule = resolved.rule;
        if (resolved.error) decision.finalStatus = resolved.error;
      });

      const psBoxes = unique(
        decisions.filter(decision => decision.flow === 'P&S' && decision.aeValue).map(decision => decision.row.boxId)
      );
      const psRawByBox = new Map();
      phaseCompleted = 0;
      setStatus('P&S input/output mapping GET: 0/' + psBoxes.length + ' · up to ' + DEFAULTS.concurrency + ' concurrent');
      await mapWithLimit(psBoxes, DEFAULTS.concurrency, async boxId => {
        const mappingResult = await getMapping(boxId, settings, stats, sourceRequestContext);
        psRawByBox.set(boxId, {
          mapping: mappingResult,
          mappingParsed: mappingResult?.ok ? parseMapping(mappingResult.body) : null
        });
        phaseCompleted += 1;
        setStatus(
          'P&S input/output mapping GET: ' + phaseCompleted + '/' + psBoxes.length
        );
      });

      const mismatchedPsBoxes = psBoxes.filter(boxId =>
        wrongWarehouse(psRawByBox.get(boxId)?.mapping, settings.sourceFacilityId)
      );
      if (mismatchedPsBoxes.length) {
        stats.contextMismatches += mismatchedPsBoxes.length;
        stats.contextRetries += 1;
        setStatus(
          'Retrying ' + mismatchedPsBoxes.length +
            ' mapping request(s) in isolated NCOB context after warehouse mismatch…'
        );
        for (const boxId of mismatchedPsBoxes) {
          supersedeFailedFetch(stats, psRawByBox.get(boxId)?.mapping);
          const retried = await retryPsMappingFromNativeContext(boxId, settings, stats);
          psRawByBox.set(boxId, retried);
        }
      }

      let sourceContextRestoreFailure = null;
      if (mismatchedPsBoxes.length) {
        setStatus('Restoring source context after isolated mapping fallback…');
        try {
          sourceRequestContext = await prepareFacilityContext(
            settings.sourceFacilityId,
            'source',
            stats,
            { forceFresh: true, reason: 'restore-source-after-mapping-fallback' }
          );
        } catch (error) {
          sourceContextRestoreFailure = facilityContextFailure(
            settings.sourceFacilityId,
            'source',
            error
          );
        }
      }

      const deepBoxData = new Map();
      psBoxes.forEach(boxId => {
        const raw = psRawByBox.get(boxId) || {};
        const warnings = [];
        let mapping = null;
        if (raw.mapping?.ok) {
          mapping = raw.mappingParsed || parseMapping(raw.mapping.body);
          if (mapping.schemaWarning) warnings.push(mapping.schemaWarning);
        } else {
          warnings.push(apiFailure('Input/output mapping', raw.mapping));
        }
        deepBoxData.set(boxId, {
          mapping,
          mappingExternalPicklistId: exactText(mapping?.outputExternalReferenceId),
          warnings
        });
      });

      const tlIdsByContext = new Map();
      decisions.forEach(decision => {
        if (!decision.aeValue || !decision.flow) return;
        const contextKey = iwitKey(decision.row);
        if (!tlIdsByContext.has(contextKey)) tlIdsByContext.set(contextKey, new Set());
        const ids = tlIdsByContext.get(contextKey);
        if (looksLikeTlId(decision.outboundTlId)) ids.add(decision.outboundTlId);
        const deepBox = deepBoxData.get(decision.row.boxId);
        deepBox?.mapping?.tlIds.forEach(id => ids.add(id));
      });
      const allTlIds = unique(
        Array.from(tlIdsByContext.values()).flatMap(set => Array.from(set))
      );
      const tlRawById = new Map();
      const tlById = new Map();
      const tlFailureById = new Map();
      phaseCompleted = 0;
      setStatus('TL pick paths: 0/' + allTlIds.length);
      if (sourceContextRestoreFailure) {
        allTlIds.forEach(tlId => tlRawById.set(tlId, sourceContextRestoreFailure));
      } else {
        await mapWithLimit(allTlIds, DEFAULTS.concurrency, async tlId => {
          const result = await getTl(tlId, settings, stats, sourceRequestContext);
          tlRawById.set(tlId, result);
          phaseCompleted += 1;
          setStatus('TL pick paths: ' + phaseCompleted + '/' + allTlIds.length);
        });
      }

      const mismatchedTlIds = allTlIds.filter(tlId =>
        wrongWarehouse(tlRawById.get(tlId), settings.sourceFacilityId)
      );
      if (mismatchedTlIds.length) {
        stats.contextMismatches += mismatchedTlIds.length;
        stats.contextRetries += 1;
        setStatus(
          'Detected ' + mismatchedTlIds.length +
            ' TL warehouse-context mismatch(es); recreating source context once…'
        );
        try {
          sourceRequestContext = await prepareFacilityContext(
            settings.sourceFacilityId,
            'source',
            stats,
            { forceFresh: true, reason: 'tl-wrong-warehouse-retry' }
          );
          await mapWithLimit(mismatchedTlIds, DEFAULTS.concurrency, async tlId => {
            supersedeFailedFetch(stats, tlRawById.get(tlId));
            const retried = await getTl(tlId, settings, stats, sourceRequestContext);
            const repeatedMismatch = wrongWarehouse(retried, settings.sourceFacilityId);
            if (repeatedMismatch) retried.contextMismatch = repeatedMismatch;
            tlRawById.set(tlId, retried);
          });
        } catch (error) {
          const failure = facilityContextFailure(settings.sourceFacilityId, 'source', error);
          mismatchedTlIds.forEach(tlId => tlRawById.set(tlId, failure));
        }
      }

      allTlIds.forEach(tlId => {
        const result = tlRawById.get(tlId);
        if (result?.ok) tlById.set(tlId, parseTl(result.body, tlId));
        else tlFailureById.set(tlId, apiFailure('TL ' + tlId, result));
      });

      const tlSequenceScopes = buildTlSequenceScopes(
        decisions,
        deepBoxData,
        allocationContexts
      );
      const tlSequenceResultsByContext = new Map();
      tlSequenceScopes.forEach((scope, contextKey) => {
        tlSequenceResultsByContext.set(
          contextKey,
          tlSequenceCoverageEvidence(
            scope.destinationBoxes,
            scope.shortUnitsByFsn,
            Array.from(tlIdsByContext.get(contextKey) || []),
            tlById
          )
        );
      });

      const failureRecords = [];
      uniqueIwitRows.forEach(row => {
        failureRecords.push(
          finalFailureRecord(iwitResults.get(iwitKey(row)), {
            requestType: 'IWIT/MWIT',
            boxId: row.boxId,
            documentId: row.documentId,
            contextType: 'iwit'
          })
        );
      });
      outboundBoxes.forEach(boxId => {
        failureRecords.push(
          finalFailureRecord(outboundResults.get(boxId), {
            requestType: 'Outbound details',
            boxId,
            contextType: 'source'
          })
        );
      });
      psBoxes.forEach(boxId => {
        const raw = psRawByBox.get(boxId) || {};
        failureRecords.push(
          finalFailureRecord(raw.mapping, {
            requestType: 'P&S mapping',
            boxId,
            contextType: 'ps-mapping'
          })
        );
      });
      allTlIds.forEach(tlId => {
        failureRecords.push(
          finalFailureRecord(tlRawById.get(tlId), {
            requestType: 'TL picklist',
            tlId,
            contextType: 'source'
          })
        );
      });
      stats.failureLedger = dedupeFailureLedger(failureRecords);
      stats.failureBreakdown = failureBreakdown(stats.failureLedger);
      stats.reconciledFailureCount = stats.failureLedger.length;

      const finalRows = decisions.map(decision => {
        const boxData = deepBoxData.get(decision.row.boxId) || {
          mapping: null,
          mappingExternalPicklistId: '',
          warnings: []
        };
        const contextKey = iwitKey(decision.row);
        const tlIds = Array.from(tlIdsByContext.get(contextKey) || []);
        const mappingTargetItems = (boxData.mapping?.items || []).filter(
          item => fsnKey(item.fsn) === fsnKey(decision.row.fsn)
        );
        const inputBoxes = unique(
          (mappingTargetItems.length ? mappingTargetItems : boxData.mapping?.items || [])
            .map(item => item.inputContainerId)
        );
        const candidateFsns = [
          ...decision.mismatchCandidates,
          ...decision.misshipmentCandidates
        ].map(candidate => candidate.fsn);
        const path = analyseTlPath(
          decision.row.fsn,
          decision.row.boxId,
          candidateFsns,
          tlIds,
          tlById
        );
        const tlSequenceResult = tlSequenceResultsByContext.get(contextKey);
        const tlSequenceEvidence =
          tlSequenceResult?.evidenceByFsn.get(fsnKey(decision.row.fsn)) || [];
        const tlSequenceDetails =
          tlSequenceResult?.detailsByFsn.get(fsnKey(decision.row.fsn)) || [];
        const bestTlSequenceDetail = [...tlSequenceDetails].sort((left, right) =>
          Number(right.inQualifyingBlock) - Number(left.inQualifyingBlock) ||
          right.coverage - left.coverage ||
          right.blockShortUnitCount - left.blockShortUnitCount
        )[0] || null;
        const tlSequenceCoverage = bestTlSequenceDetail?.coverage ?? null;
        const tlSequenceDestinationScope = Array.from(
          tlSequenceScopes.get(contextKey)?.destinationBoxes || []
        );
        decision.tlSequenceMissingRateGate = passesTlSequenceMissingRateGate(decision);
        decision.tlSequenceBoxUnitGate = passesTlSequenceBoxUnitGate(decision);
        decision.tlSequenceWise =
          isTlSequenceEligible(decision) && tlSequenceEvidence.length > 0;
        decision.tlSequenceEvidence = tlSequenceEvidence;
        decision.tlSequenceCoverage = tlSequenceCoverage;
        path.tlSequenceWise = decision.tlSequenceWise;
        path.tlSequenceEvidence = tlSequenceEvidence;
        path.tlSequenceCoverage = tlSequenceCoverage;
        path.tlSequenceMissingRateGate = decision.tlSequenceMissingRateGate;
        path.tlSequenceBoxUnitGate = decision.tlSequenceBoxUnitGate;
        path.tlSequenceMatchedShortUnits = bestTlSequenceDetail?.matchedShortUnitCount ?? null;
        path.tlSequenceBlockShortUnits = bestTlSequenceDetail?.blockShortUnitCount ?? null;
        path.tlSequenceBlockStart = bestTlSequenceDetail?.startSequence ?? null;
        path.tlSequenceBlockEnd = bestTlSequenceDetail?.endSequence ?? null;
        path.tlSequenceFsnUnitPositions = bestTlSequenceDetail?.blockUnitPositionsForFsn || [];
        path.tlSequencePartialUnitInference = Boolean(
          bestTlSequenceDetail?.partialUnitInference
        );
        path.tlSequenceDestinationScope = tlSequenceDestinationScope;
        const warnings = [
          decision.outboundEvidenceWarning,
          ...boxData.warnings,
          ...tlIds.map(id => tlFailureById.get(id)).filter(Boolean),
          ...path.warnings
        ];
        const mappingPhysical = boxData.mapping?.summary;
        const tlPhysical = path.physical;
        const useMappingPhysical =
          decision.flow === 'P&S' && Boolean(mappingPhysical?.totalQuantity);
        const basePhysical = useMappingPhysical
          ? mappingPhysical
          : tlPhysical?.totalQuantity
            ? tlPhysical
            : mappingPhysical?.totalQuantity
              ? mappingPhysical
              : physicalSummary([]);
        const physical = overlayExactBoxTitleWeight(basePhysical, tlPhysical);
        const physicalSource = useMappingPhysical
          ? 'P&S input/output mapping'
          : tlPhysical?.totalQuantity
            ? 'TL items resolved to exact Box ID'
            : mappingPhysical?.totalQuantity
              ? 'P&S input/output mapping fallback'
              : '';
        const productImages = resolveProductImages(
          decision,
          allocationContexts.get(contextKey),
          boxData.mapping?.items || [],
          tlIds,
          tlById
        );
        decision.expectedImageFsn = productImages.expected.fsn || decision.row.fsn;
        decision.expectedImageUrl = productImages.expected.url;
        decision.expectedImageSource = productImages.expected.source;
        decision.excessImageFsn = productImages.excess.fsn;
        decision.excessImageUrl = productImages.excess.url;
        decision.excessImageSource = productImages.excess.source;
        decision.tlNeighbourPreview = resolveTlNeighbourImages(
          decision.row.fsn,
          decision.row.boxId,
          decision.flow === 'P&S' ? inputBoxes : [],
          tlIds,
          tlById
        );
        path.neighbourPreview = decision.tlNeighbourPreview;
        const orphanRule = applyOrphanToteRules(decision, physical);
        decision.aeValue = orphanRule.label;
        decision.orphanReasons = orphanRule.reasons;
        decision.specialRule = unique([decision.specialRule, orphanRule.rule]).join(' ');
        const deep = {
          mapping: boxData.mapping,
          mappingExternalPicklistId: boxData.mappingExternalPicklistId,
          mappingTargetPresent: mappingTargetItems.length > 0,
          inputBoxes,
          tlIds,
          path,
          physical,
          physicalSource,
          warnings: unique(warnings)
        };

        if (!decision.aeValue && decision.finalStatus === 'Classified') {
          decision.finalStatus = 'No confirmed AE dropdown label matched.';
        } else if (decision.aeValue && deep.warnings.length) {
          decision.finalStatus = 'Classified; deep evidence partial.';
        }
        decision.deep = deep;
        decision.analysis = buildOperationalAnalysis(decision, deep);
        return decision;
      });

      await enrichAttribution(finalRows, settings, stats);
      const auditTsv = buildAuditTsv(finalRows);
      const aeQuantityImagesTsv = buildAeQuantityImagesTsv(finalRows);
      aeOutput.value = finalRows.map(row => row.aeValue).join('\n');
      auditOutput.value = auditTsv;
      copyAeButton.disabled = false;
      copyAeQuantityImagesButton.disabled = false;
      copyAuditButton.disabled = false;
      downloadAuditButton.disabled = false;
      downloadJsonButton.disabled = false;

      const classifiedCount = finalRows.filter(row => row.aeValue).length;
      const reviewCount = finalRows.length - classifiedCount;
      const partialCount = finalRows.filter(row => row.finalStatus.includes('partial')).length;
      const failureBreakdownText = stats.failureBreakdown.length
        ? stats.failureBreakdown.map(item => item.category + '=' + item.count).join(', ')
        : 'none';
      const summary = {
        version: VERSION,
        completedAt: isoNow(),
        inputRows: finalRows.length,
        attributionPartialRows: finalRows.filter(row => row.attribution?.warnings?.length).length,
        classified: classifiedCount,
        reviewRequired: reviewCount,
        deepEvidencePartial: partialCount,
        caseMasterCount: caseMaster.caseSizeByFsn.size,
        bulkMasterCount: bulkMaster.bulkFsns.size,
        sourceFacilityId: settings.sourceFacilityId,
        api: stats
      };
      lastRun = {
        auditTsv,
        aeQuantityImagesTsv,
        jsonEvidence: {
          type: 'flo-lite-rca-derived-evidence',
          summary,
          rows: finalRows.map(serialisableRow)
        }
      };

      setStatus(
        'Finished: ' + classifiedCount + ' classified, ' + reviewCount +
          ' review-required, ' + partialCount + ' with partial deep evidence.\n' +
          'API: ' + stats.networkRequests + ' network request(s), ' + stats.cacheHits +
          ' cache hit(s), ' + stats.retries + ' retry attempt(s), ' +
          stats.reconciledFailureCount + ' final evidence failure(s).\n' +
          'Failure breakdown: ' + failureBreakdownText + '.\n' +
          'Facility contexts: ' + stats.contextSwitches + ' isolated realm(s), ' +
          stats.contextRetries + ' guarded retry/retries, ' + stats.contextMismatches +
          ' mismatch(es), ' + stats.contextFailures + ' establishment failure(s).\n' +
          'Attribution: ' + finalRows.filter(row => row.attribution?.warnings?.length).length + ' row(s) partial/unavailable; see appended audit columns.\n' +
          'Masters: ' + caseMaster.caseSizeByFsn.size + ' Case, ' +
          bulkMaster.bulkFsns.size + ' Bulk. Check Audit before pasting AE.'
      );

      console.table(
        finalRows.map(row => ({
          Row: row.row.inputRow,
          Box: row.row.boxId,
          FSN: row.row.fsn,
          Flow: row.flow,
          Short: row.unexplainedShortQuantity,
          Mismatch: row.mismatchQuantity,
          Misshipment: row.misshipmentQuantity,
          Hypothesis: row.analysis.hypothesis,
          Confidence: row.analysis.confidence,
          AE: row.aeValue,
          Status: row.finalStatus
        }))
      );
    } catch (error) {
      console.error(error);
      setStatus('Unexpected run error: ' + (error?.message || String(error)), true);
    } finally {
      runButton.disabled = false;
      runButton.textContent = 'Run complete RCA';
    }
  }

  // V2.3.5: exact box + FSN attribution; never changes RCA classifications.
  function attributionPairs(body, outputBox) {
    const pairs = new Map();
    for (const item of firstArray(body, ['itemDetails', 'item_details'])) {
      const attributes = directField(item, ['attributes']);
      const fsns = unique([
        fsnKey(directField(item, ['fsn'])),
        ...(Array.isArray(attributes) ? attributes.filter(attribute =>
          exactText(attribute.name).toLowerCase() === 'fsn').map(attribute => fsnKey(attribute.value)) : [])
      ]);
      const inputBox = scalarIdentifier(directField(item, ['inputContainerId', 'input_container_id']));
      const tlId = exactText(directField(item, ['externalReferenceId', 'external_reference_id']));
      const mappedOutput = scalarIdentifier(directField(item, ['outputContainerId', 'output_container_id']));
      // Missing or contradictory FSNs are never wildcards. Preserve the same-entry pair.
      if (fsns.length !== 1 || !inputBox || !looksLikeTlId(tlId) ||
          (mappedOutput && mappedOutput !== outputBox)) continue;
      const key = JSON.stringify([inputBox, tlId]);
      if (!pairs.has(key)) pairs.set(key, {inputBox, tlId, fsns: []});
      const pair = pairs.get(key);
      pair.fsns = unique([...pair.fsns, ...fsns]);
    }
    return [...pairs.values()];
  }

  function liveCsrfToken() {
    const frame = document.getElementById('flo-lite-rca-facility-context-frame');
    for (const doc of [frame?.contentDocument, document].filter(Boolean)) {
      const meta = doc.querySelector?.('meta[name="csrf-token"], meta[name="csrfToken"], meta[name="_csrf"]');
      if (meta?.content) return meta.content;
      for (const entry of (doc.cookie || '').split(';')) {
        const separator = entry.indexOf('=');
        const name = entry.slice(0, separator).trim().toLowerCase();
        if (['csrf-token', 'csrftoken', 'xsrf-token', '_csrf'].includes(name)) {
          try { return decodeURIComponent(entry.slice(separator + 1)); } catch { return ''; }
        }
      }
    }
    return '';
  }

  async function fetchSorter(pair, settings, stats, context) {
    const path = '/flo-lite-routes-api/outbound-picking-proxy/api/v3.0/containers/details/label/' +
      encodeURIComponent(pair.inputBox);
    const headers = {
      'Content-Type': 'application/json', 'X-Client-Id': 'WH',
      'X-Facility-Id': settings.sourceFacilityId, 'X-Tenant-Id': 'FKI',
      'X-Proxy-User': settings.userId
    };
    const token = liveCsrfToken();
    if (token) headers['Csrf-Token'] = token;
    return fetchJson({path, method: 'POST', body: {externalPicklistId: pair.tlId},
      headers, cache: new Map(), cacheKey: '', stats, maxRetries: 0,
      requestContext: context, requestType: 'Sorter attribution', boxId: pair.inputBox, tlId: pair.tlId});
  }

  function checkAttributionResponse(result, settings) {
    if (result?.status === 401 || (typeof result?.body === 'string' &&
        /<html|<!doctype/i.test(result.body))) throw new Error('Login session expired during attribution. Sign in again.');
    if (!result?.ok) return 'HTTP ' + (result?.status || 0) + ' lookup failed';
    if (result.contextMismatch || wrongWarehouse(result, settings.sourceFacilityId)) return 'Facility context mismatch';
    if (!result.body || typeof result.body !== 'object') return 'Invalid JSON response';
    return '';
  }

  async function enrichAttribution(rows, settings, stats) {
    const byBox = new Map();
    const tlCache = new Map();
    const sorterCache = new Map();
    let completed = 0;
    const boxes = unique(rows.map(row => row.row.boxId).filter(Boolean));
    for (const box of boxes) {
      setStatus('Employee attribution: ' + completed + '/' + boxes.length);
      const record = {dispatchedBy: '', sortedBy: [], pickedBy: [], links: [], warnings: []};
      byBox.set(box, record);
      // Context changes are serial: requests must not race facility-frame navigation.
      let context;
      try { context = await prepareFacilityContext(settings.sourceFacilityId, 'source', stats); }
      catch { record.warnings.push('Could not establish source facility context'); continue; }
      const outbound = await getOutbound(box, settings, stats, context);
      const outboundError = checkAttributionResponse(outbound, settings);
      if (outboundError) { record.warnings.push('Dispatch: ' + outboundError); continue; }
      const attributes = deepField(outbound.body, ['shipment_attributes', 'shipmentAttributes'], 4);
      record.dispatchedBy = scalarIdentifier(directField(attributes, ['dispatched_by', 'dispatchedBy']));
      if (!record.dispatchedBy) record.warnings.push('Dispatched by missing/null');
      const parsed = parseOutbound(outbound.body);
      let pairs = [];
      if (parsed.flow === 'P&S') {
        try { context = await prepareFacilityContext(settings.sourceFacilityId, 'ps-mapping', stats, {boxId: box}); }
        catch { record.warnings.push('Could not establish input/output mapping context'); continue; }
        const mapping = await getMapping(box, settings, stats, context);
        const mappingError = checkAttributionResponse(mapping, settings);
        if (mappingError) record.warnings.push('Mapping: ' + mappingError);
        else {
          const requestedFsns = new Set(rows.filter(row => row.row.boxId === box).map(row => fsnKey(row.row.fsn)));
          pairs = attributionPairs(mapping.body, box).filter(pair => pair.fsns.some(fsn => requestedFsns.has(fsn)));
          if (!pairs.length) record.warnings.push('No exact FSN/input-box/TL mapping for requested rows');
        }
      } else if (looksLikeTlId(parsed.tlId)) {
        pairs = [{inputBox: box, tlId: parsed.tlId,
          fsns: unique(rows.filter(row => row.row.boxId === box).map(row => fsnKey(row.row.fsn)))}];
        record.warnings.push('Sorter lookup not applicable: no P&S input mapping');
      } else record.warnings.push('No mapped TL available; sorter and picker unavailable');
      for (const pair of pairs) {
        const link = {...pair, sorterLdap: '', pickedBy: '', warnings: []};
        record.links.push(link);
        if (!tlCache.has(pair.tlId)) tlCache.set(pair.tlId, await getTl(pair.tlId, settings, stats, context));
        const tl = tlCache.get(pair.tlId);
        const tlError = checkAttributionResponse(tl, settings);
        if (tlError) link.warnings.push('TL: ' + tlError);
        else link.pickedBy = scalarIdentifier(directField(tl.body, ['assignedTo']));
        if (!link.pickedBy) link.warnings.push('TL assignedTo missing/unavailable');
        if (parsed.flow === 'P&S') {
          const key = JSON.stringify([pair.inputBox, pair.tlId]);
          if (!sorterCache.has(key)) sorterCache.set(key, await fetchSorter(pair, settings, stats, context));
          const detail = sorterCache.get(key);
          const detailError = checkAttributionResponse(detail, settings);
          if (detailError) link.warnings.push('Sorter: ' + detailError);
          else if ((detail.body.boxLabel && detail.body.boxLabel !== pair.inputBox) ||
                   (detail.body.externalPicklistId && detail.body.externalPicklistId !== pair.tlId))
            link.warnings.push('Sorter response box/TL mismatch');
          else link.sorterLdap = scalarIdentifier(directField(detail.body, ['sorterLdap']));
          if (!link.sorterLdap) link.warnings.push('sorterLdap missing/unavailable');
        }
      }
      completed++;
    }
    for (const row of rows) {
      const record = byBox.get(row.row.boxId) || {dispatchedBy: '', links: [], warnings: ['No box ID']};
      const links = record.links.filter(link => link.fsns.includes(fsnKey(row.row.fsn)));
      const conflicts = [];
      const singlePerson = (field, label) => {
        const values = unique(links.map(link => link[field]));
        if (values.length > 1) {
          conflicts.push(label + ' conflict for exact box+FSN; see attribution links');
          return '';
        }
        return values[0] || '';
      };
      const sortedBy = singlePerson('sorterLdap', 'Sorted by');
      const pickedBy = singlePerson('pickedBy', 'Picked by');
      row.attribution = {...record, links,
        sortedBy, pickedBy,
        warnings: unique([...record.warnings, ...conflicts, ...links.flatMap(link => link.warnings),
          ...(!links.length ? ['No input-box/TL relationship for this FSN'] : [])])};
    }
  }

  AUDIT_COLUMNS.push(
    ['Dispatched by', row => row.attribution?.dispatchedBy || ''],
    ['Sorted by', row => row.attribution?.sortedBy || []],
    ['Picked by', row => row.attribution?.pickedBy || []],
    ['Attribution status', row => row.attribution?.warnings?.length ? 'Partial/unavailable' : 'Complete'],
    ['Attribution warnings', row => row.attribution?.warnings || []],
    ['Attribution box/TL links', row => JSON.stringify(row.attribution?.links || [])]
  );

  runButton.onclick = runBatch;

  const browserSelfTest = runSelfTests();
  if (!browserSelfTest.passed) {
    runButton.disabled = true;
    setStatus('Internal self-test failed: ' + browserSelfTest.failures.join(', '), true);
  } else {
    refreshMasterStatus();
    if (!storedState.sourceFacilityId || !storedState.userId) {
      setStatus(
        'First-time setup required. Enter this person’s source facility and Flo-lite user ID, then click Save settings.',
        true
      );
    } else {
      setStatus('Ready. Internal checks passed: ' + browserSelfTest.count + '.');
    }
  }
  if (!storedState.sourceFacilityId) sourceFacilityInput.focus();
  else if (!storedState.userId) userIdInput.focus();
  else input.focus();
})();
