  function removeFacilityContextFrame() {
    try {
      facilityContextBroker.frame?.remove();
    } catch {
      // The frame is optional cleanup only.
    }
    facilityContextBroker.frame = null;
    facilityContextBroker.currentKey = '';
    facilityContextBroker.currentContext = null;
    facilityContextBroker.loadPromise = null;
  }

  function facilityContextToken() {
    const randomPart = globalThis.crypto?.randomUUID
      ? globalThis.crypto.randomUUID()
      : Math.random().toString(36).slice(2);
    return Date.now() + '-' + randomPart;
  }

  function facilityContextFailure(facilityId, contextType, error) {
    const message = error?.message || String(error);
    return {
      ok: false,
      status: 0,
      body: null,
      error:
        'Unable to establish isolated ' + contextType + ' context for ' + facilityId + ': ' + message,
      fromCache: false,
      contextFailure: { intendedFacility: facilityId, contextType, message }
    };
  }

  async function prepareFacilityContext(facilityId, contextType, stats, options = {}) {
    const cleanFacility = exactText(facilityId);
    if (!cleanFacility) throw new Error('Cannot prepare a blank Flo-lite facility context.');
    const exactBoxId = exactText(options.boxId);
    if (contextType === 'ps-mapping' && !exactBoxId) {
      throw new Error('Cannot prepare a P&S NCOB context without an exact Box ID.');
    }
    const key = contextType + '|' + cleanFacility + '|' + exactBoxId;
    const forceFresh = options.forceFresh === true;
    if (!forceFresh && facilityContextBroker.currentKey === key && facilityContextBroker.currentContext) {
      return facilityContextBroker.currentContext;
    }
    if (facilityContextBroker.loadPromise) await facilityContextBroker.loadPromise;
    removeFacilityContextFrame();

    const path = facilityContextPath(cleanFacility, contextType, exactBoxId);
    const contextUrl = new URL(path, location.origin);
    contextUrl.searchParams.set('__flo_lite_rca_context', facilityContextToken());
    const absoluteUrl = contextUrl.href;
    const frame = document.createElement('iframe');
    frame.id = 'flo-lite-rca-facility-context-frame';
    frame.setAttribute('aria-hidden', 'true');
    frame.style.cssText =
      'position:fixed;left:-10000px;top:0;width:2px;height:2px;border:0;opacity:.01;pointer-events:none;';
    facilityContextBroker.frame = frame;

    facilityContextBroker.loadPromise = new Promise((resolve, reject) => {
      let settled = false;
      const finish = (error, context) => {
        if (settled) return;
        settled = true;
        clearTimeout(timeout);
        frame.onload = null;
        frame.onerror = null;
        if (error) reject(error);
        else resolve(context);
      };
      const timeout = setTimeout(() => {
        finish(new Error('Facility page did not finish loading within 25 seconds.'));
      }, 25000);

      frame.onload = () => {
        setTimeout(() => {
          try {
            if (frame.contentWindow?.location?.origin !== location.origin) {
              throw new Error('Facility context frame did not remain on the Flo-lite origin.');
            }
            let loadedPath = frame.contentWindow.location.pathname;
            const expectedPrefix = '/flo-lite/' + encodeURIComponent(cleanFacility) + '/';
            if (!loadedPath.startsWith(expectedPrefix)) {
              throw new Error(
                'Facility frame loaded unexpected route ' + loadedPath +
                  '; expected prefix ' + expectedPrefix + '.'
              );
            }
            if (
              contextType === 'ps-mapping' &&
              loadedPath.replace(/\/$/, '') !== path.replace(/\/$/, '')
            ) {
              throw new Error(
                'P&S context loaded unexpected route ' + loadedPath +
                  '; expected blank NCOB route ' + path + '.'
              );
            }
            if (contextType === 'ps-mapping') {
              const exactBoxUrl = new URL(
                psNcobBoxPath(cleanFacility, exactBoxId),
                location.origin
              );
              exactBoxUrl.searchParams.set('__flo_lite_rca_context', facilityContextToken());
              frame.contentWindow.history.replaceState(
                { floLiteRcaControlledContext: true },
                '',
                exactBoxUrl.pathname + exactBoxUrl.search
              );
              loadedPath = frame.contentWindow.location.pathname;
              if (loadedPath.replace(/\/$/, '') !== exactBoxUrl.pathname.replace(/\/$/, '')) {
                throw new Error(
                  'P&S context could not assume exact Box route ' + exactBoxUrl.pathname + '.'
                );
              }
            }
            const frameFetch = frame.contentWindow.fetch;
            if (typeof frameFetch !== 'function') throw new Error('Facility frame fetch is unavailable.');
            finish(null, {
              facilityId: cleanFacility,
              contextType,
              boxId: exactBoxId,
              mode: 'fresh-facility-frame',
              referrer: frame.contentWindow.location.href,
              fetchFn: frameFetch.bind(frame.contentWindow),
              warning: '',
              reason: exactText(options.reason)
            });
          } catch (error) {
            finish(error);
          }
        }, contextType === 'ps-mapping' ? 1800 : 1200);
      };
      frame.onerror = () => {
        finish(new Error('Facility page frame failed to load.'));
      };
      frame.src = absoluteUrl;
      document.body.appendChild(frame);
    });

    try {
      const context = await facilityContextBroker.loadPromise;
      facilityContextBroker.currentKey = key;
      facilityContextBroker.currentContext = context;
      stats.contextSwitches += 1;
      stats.contexts.push({
        facilityId: cleanFacility,
        contextType,
        boxId: exactBoxId,
        mode: context.mode,
        reason: context.reason,
        warning: ''
      });
      return context;
    } catch (error) {
      stats.contextFailures += 1;
      stats.contexts.push({
        facilityId: cleanFacility,
        contextType,
        boxId: exactBoxId,
        mode: 'failed',
        reason: exactText(options.reason),
        warning: error?.message || String(error)
      });
      removeFacilityContextFrame();
      throw error;
    } finally {
      facilityContextBroker.loadPromise = null;
    }
  }

